# ─────────────────────────────────────────────────────────────────────────
# Widedrop ESS — environment reference
#
# Copy to apps/api/.env for local development. NEVER commit a filled-in copy.
# The API validates every variable at boot and refuses to start on a missing
# or low-entropy secret, so a misconfigured deployment fails loudly rather
# than running with an insecure default.
#
# Generate secrets with:
#   openssl rand -base64 48      # PASSWORD_PEPPER
#   openssl rand -base64 32      # ENCRYPTION_KEK, AUDIT_HMAC_KEY (32 bytes)
#   openssl genpkey -algorithm ed25519 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#   base64 -w0 private.pem       # JWT_PRIVATE_KEY
#   base64 -w0 public.pem        # JWT_PUBLIC_KEY
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Public origins. Must be https in production.
API_PUBLIC_URL=http://127.0.0.1:4000
WEB_PUBLIC_URL=http://127.0.0.1:5173
# Exact browser origins allowed to call the API with credentials.
# No wildcard, no http:// in production — the API answers with credentials.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────
# Production must specify sslmode=require or verify-full.
#
# Behind a transaction-mode pooler (Supabase's Supavisor on port 6543,
# PgBouncer, RDS Proxy) two things are required and the validator enforces
# both: `?pgbouncer=true` on this URL, because the pooler cannot hold the
# prepared statements Prisma creates by default; and DIRECT_DATABASE_URL
# below, because `prisma migrate` runs DDL and takes an advisory lock, neither
# of which survives a pooler handing the connection to somebody else between
# statements.
#
#   Supabase pooled : postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
#   Supabase direct : postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://ess:ess_local_dev_only@127.0.0.1:5433/widedrop_ess?schema=ess
# The same value as above wherever nothing is pooling in front of Postgres, as
# locally. It cannot be blank: the schema declares `directUrl`, and Prisma
# refuses to read a schema whose environment variables are missing — so an
# empty one fails `db:migrate` before it reaches the database. The API process
# itself never opens this connection; only the Prisma CLI does.
DIRECT_DATABASE_URL=postgresql://ess:ess_local_dev_only@127.0.0.1:5433/widedrop_ess?schema=ess

# ── Authentication ──────────────────────────────────────────────────────
# Ed25519 keys, base64-encoded PEM. Rotate by issuing a new key id and
# keeping the old public key until every token signed with it has expired.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=ess-2026-01
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=1209600

# Mixed into every password hash, so a stolen database cannot be attacked
# offline without also stealing this. Rotating it invalidates every password.
PASSWORD_PEPPER=

# Cookie scope. COOKIE_DOMAIN lets ess.widedrop.com and api.ess.widedrop.com
# share the refresh cookie as same-site, which is why SameSite=Lax is enough.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Encryption ──────────────────────────────────────────────────────────
# 32 bytes, base64. Encrypts bank accounts, statutory identifiers and other
# sensitive columns. Losing it makes that data unrecoverable.
ENCRYPTION_KEK=
ENCRYPTION_KEY_VERSION=v1
# Seals the audit chain. The database never sees it, which is what makes
# tampering detectable.
AUDIT_HMAC_KEY=

# ── Rate limiting ───────────────────────────────────────────────────────
# The limiter needs a store every instance can see. Without one, each gets its
# own counters and an account lockout holds only on whichever instance the next
# attempt reaches — which is not a lockout.
#
# Redis is the fastest and is preferred where it exists. Left unset, the
# limiter uses the database, which is shared for the same reason and costs one
# upsert per limited request. That is the right trade at this size; set
# REDIS_URL when it stops being.
REDIS_URL=

# Allow the in-process limiter in production. There is exactly one situation
# where this is not a mistake: a single instance that will never be scaled out.
# It has to be said out loud because the failure is silent — nothing looks
# wrong, the limiter simply stops limiting at the rate it claims.
RATE_LIMIT_ALLOW_IN_PROCESS=false

# ── Object storage ──────────────────────────────────────────────────────
# Production must be s3: a container filesystem is ephemeral and payslips
# are business records.
#
# S3_ENDPOINT is set only for an S3-compatible store, which also selects
# path-style addressing. Leave it unset for AWS S3 itself.
#
#   Supabase : https://<project-ref>.storage.supabase.co/storage/v1/s3
#              with the region and the access-key pair from
#              Project Settings -> Storage -> S3 access keys. The keys bypass
#              row-level security, so they are server-side only and never
#              reach a VITE_ variable.
STORAGE_DRIVER=filesystem
STORAGE_LOCAL_PATH=./.storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300

# ── Email ───────────────────────────────────────────────────────────────
# Production must be smtp: help-desk mail has to actually be delivered.
MAIL_DRIVER=file
MAIL_FROM=no-reply@widedroptech.com
HELPDESK_EMAIL=helpdesk@widedroptech.com
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FILE_PATH=./.mail

# ── Outbound integrations ───────────────────────────────────────────────
# Checks new passwords against Have I Been Pwned using k-anonymity: only five
# characters of the hash leave the process. Fails open if unreachable.
HIBP_ENABLED=true
HIBP_TIMEOUT_MS=2000

# ── Background work ─────────────────────────────────────────────────────
# Two ways to run it, and a deployment needs one of them. Without either, mail
# sits in the outbox and payslip documents are never rendered — silently,
# because nothing is failing.
#
#   A container : run `node dist/worker.js` beside the API. It loops on the
#                 interval below and needs no token.
#   Serverless  : there is no process to loop in, so a scheduler calls
#                 POST /api/v1/jobs/:name instead. Set the token below and run
#                 infra/supabase/cron.sql.
#
# Unset, the endpoint is not registered at all — a stronger guarantee than an
# endpoint that exists and checks. Generate with `openssl rand -base64 48`.
JOB_RUNNER_TOKEN=

WORKER_POLL_INTERVAL_MS=15000
# ── Which address a request is attributed to ────────────────────────────
# This decides the bucket a per-IP rate limit counts against and the address
# the audit trail records, so a client that can choose it can slip past both.
#
# TRUST_PROXY: only true when a proxy really is in front. With none, the
# client's address is the socket's and a forwarded header is just something
# the client typed.
TRUST_PROXY=false

# How many proxies append to X-Forwarded-For between the client and here. One
# for a single load balancer; two behind a CDN in front of one.
#
# The header is a trail, not a field: each proxy appends the address it
# received the connection from, so the *leftmost* entry is whatever the client
# sent. The trail is read from the right, and this says how far in to count.
# Too low reads attacker-supplied input; too high makes several clients share
# a bucket, which is the safer way to be wrong.
TRUSTED_PROXY_HOPS=1

# A single-value header the platform sets itself, where one exists — it
# overwrites rather than appends, so nothing a client sends can reach it, and
# it is preferred over counting.
#
#   Netlify    x-nf-client-connection-ip
#   Cloudflare cf-connecting-ip
#
# Only ever a header the proxy in front is known to overwrite: one it merely
# passes through would be worse than counting.
CLIENT_IP_HEADER=

# ── Seed (optional) ─────────────────────────────────────────────────────
SEED_ORG_DOMAIN=widedrop.com
SEED_ORG_NAME=Widedrop Technologies
SEED_ORG_LEGAL_NAME=Widedrop Technologies Private Limited
SEED_EMPLOYEE_PREFIX=WDT
SEED_FY_START=2024
