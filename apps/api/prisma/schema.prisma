// Widedrop ESS — database schema.
//
// Authoritative specification: docs/DATA-MODEL.md. Conventions applied here:
//   - uuid primary keys, `organization_id` on every business table, composite
//     indexes leading with it
//   - money as bigint minor units (paise) — never a float
//   - `timestamptz` for instants, `date` for calendar facts
//   - sensitive columns stored as an AES-256-GCM envelope (ct/iv/tag/key
//     version/fingerprint), never as plaintext
//   - no soft deletes: lifecycle is a status enum
//
// Prisma cannot express domains, exclusion constraints, triggers, row-level
// security or partial indexes. Those live in hand-written migration SQL
// alongside the generated migrations — see prisma/sql/.

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins", "postgresqlExtensions"]
  binaryTargets   = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["ess", "ess_ops"]

  // Managed by Prisma so the shadow database used to diff migrations has them
  // too. citext keeps emails and reference codes case-insensitive; btree_gist
  // backs the EXCLUDE constraints that enforce "exactly one open effective-dated
  // row"; pg_trgm indexes directory and global search.
  extensions = [citext(schema: "ess"), pgcrypto(schema: "ess"), btree_gist(schema: "ess"), pg_trgm(schema: "ess")]
}

