// ═══════════════════════════════════════════════════════════════════════════
// Organisation
// ═══════════════════════════════════════════════════════════════════════════

model Organization {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalName            String   @map("legal_name")
  displayName          String   @map("display_name")
  domain               String   @unique @db.Citext
  timezone             String   @default("Asia/Kolkata")
  currencyCode         String   @default("INR") @map("currency_code")
  locale               String   @default("en-IN")
  /// Prefix for generated employee numbers, e.g. `WDT`.
  employeeNumberPrefix String   @default("EMP") @map("employee_number_prefix")
  /// Where portal help-desk tickets are dispatched.
  helpdeskEmail        String   @map("helpdesk_email") @db.Citext
  /// Financial year start month; 4 = April, as Indian statute requires.
  fiscalYearStartMonth Int      @default(4) @map("fiscal_year_start_month") @db.SmallInt
  logoFileObjectId     String?  @map("logo_file_object_id") @db.Uuid
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  departments       Department[]
  locations         Location[]
  costCentres       CostCentre[]
  designations      Designation[]
  users             AppUser[]
  employees         Employee[]
  fiscalYears       FiscalYear[]
  holidayCalendars  HolidayCalendar[]
  leaveTypes        LeaveType[]
  leavePeriods      LeavePeriod[]
  attendancePeriods AttendancePeriod[]
  payrollCycles     PayrollCycle[]
  payComponents     PayComponent[]
  policies          Policy[]
  announcements     Announcement[]
  ticketCategories  TicketCategory[]
  tickets           HelpdeskTicket[]
  expenseCategories ExpenseCategory[]
  documentTypes     DocumentType[]
  benefitPlans      BenefitPlan[]
  uiCopy            UiCopy[]
  auditEvents       AuditEvent[]
  fileObjects       FileObject[]
  emailOutbox       EmailOutbox[]

  @@map("organization")
  @@schema("ess")
}

model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.Citext
  name           String
  parentId       String?  @map("parent_department_id") @db.Uuid
  headEmployeeId String?  @map("head_employee_id") @db.Uuid
  /// Directory avatar accent. Resolved from design tokens when null — never random.
  accentColor    String?  @map("accent_color")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       Department?          @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Department[]         @relation("DepartmentTree")
  head         Employee?            @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  employments  EmployeeEmployment[]

  @@unique([organizationId, code], map: "ux_department__org_code")
  @@index([organizationId, isActive], map: "ix_department__org_active")
  @@map("department")
  @@schema("ess")
}

model Location {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  code              String   @db.Citext
  name              String
  city              String
  /// Two-letter ISO code; drives the professional-tax slab.
  stateCode         String   @map("state_code")
  countryCode       String   @default("IN") @map("country_code")
  timezone          String   @default("Asia/Kolkata")
  holidayCalendarId String?  @map("holiday_calendar_id") @db.Uuid
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  holidayCalendar HolidayCalendar?     @relation(fields: [holidayCalendarId], references: [id], onDelete: SetNull)
  employments     EmployeeEmployment[]

  @@unique([organizationId, code], map: "ux_location__org_code")
  @@map("location")
  @@schema("ess")
}

model CostCentre {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.Citext
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employments  EmployeeEmployment[]

  @@unique([organizationId, code], map: "ux_cost_centre__org_code")
  @@map("cost_centre")
  @@schema("ess")
}

model Designation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.Citext
  title          String
  /// Ordering for org charts and approval escalation; higher is more senior.
  grade          Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employments  EmployeeEmployment[]

  @@unique([organizationId, code], map: "ux_designation__org_code")
  @@map("designation")
  @@schema("ess")
}

/// The Indian financial year, April–March. Generated at seed so no code computes
/// a financial year ad hoc.
model FiscalYear {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Calendar year the year starts in: 2026 for FY 2026–27.
  startYear      Int      @map("start_year")
  label          String
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quarters       FiscalQuarter[]
  tdsQuarters    TdsQuarter[]
  declarations   EmployeeTaxDeclaration[]
  elections      EmployeeTaxRegimeElection[]
  form16s        Form16Document[]
  projections    EmployeeTaxProjection[]
  payslipRollups PayslipFyRollup[]
  expenseRollups ExpenseFyRollup[]

  @@unique([organizationId, startYear], map: "ux_fiscal_year__org_start")
  @@map("fiscal_year")
  @@schema("ess")
}

model FiscalQuarter {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscalYearId String   @map("fiscal_year_id") @db.Uuid
  /// 1 = Apr–Jun … 4 = Jan–Mar.
  quarter      Int      @db.SmallInt
  label        String
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fiscalYear  FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  tdsQuarters TdsQuarter[]

  @@unique([fiscalYearId, quarter], map: "ux_fiscal_quarter__year_q")
  @@map("fiscal_quarter")
  @@schema("ess")
}

/// Explanatory copy the prototype hardcoded: profile tab notes, empty-state
/// headlines, captions. Configuration, not operational data — these rows carry
/// no counts, amounts, dates or statuses. HR can change them without a deploy.
model UiCopy {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.Citext
  locale         String   @default("en-IN")
  value          String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key, locale], map: "ux_ui_copy__org_key_locale")
  @@index([organizationId, locale], map: "ix_ui_copy__org_locale")
  @@map("ui_copy")
  @@schema("ess")
}

// ═══════════════════════════════════════════════════════════════════════════
// RBAC
// ═══════════════════════════════════════════════════════════════════════════

/// Reference data, seeded. One row per permission string in
/// packages/shared/src/rbac/roles.ts.
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.Citext
  resource    String
  action      String
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permission")
  @@schema("ess")
}

/// Reference data, seeded. Exactly four rows — the four personas.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  persona     Persona  @unique
  name        String
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("role")
  @@schema("ess")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  /// SELF | DIRECT_REPORTS | REPORTING_CHAIN | DEPARTMENT | ORG
  scope        String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
  @@schema("ess")
}

/// A grant of a role to a user. Every grant and revocation is audited, and
/// revoking one bumps the user's token epoch so live sessions lose it at once.
model UserRole {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appUserId       String    @map("app_user_id") @db.Uuid
  roleId          String    @map("role_id") @db.Uuid
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  /// A time-boxed grant, for cover during leave. Null means open-ended.
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokeReason    String?   @map("revoke_reason")

  user      AppUser  @relation("UserRoles", fields: [appUserId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy AppUser? @relation("RoleGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  revokedBy AppUser? @relation("RoleRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([appUserId, revokedAt], map: "ix_user_role__user_active")
  @@index([roleId], map: "ix_user_role__role")
  @@map("user_role")
  @@schema("ess")
}

// ═══════════════════════════════════════════════════════════════════════════
// Identity
// ═══════════════════════════════════════════════════════════════════════════

model AppUser {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String     @map("organization_id") @db.Uuid
  email              String     @db.Citext
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  /// Argon2id PHC string. Null only while status is INVITED.
  passwordHash       String?    @map("password_hash")
  passwordAlgo       String     @default("argon2id") @map("password_algo")
  passwordUpdatedAt  DateTime?  @map("password_updated_at") @db.Timestamptz(6)
  passwordMustChange Boolean    @default(false) @map("password_must_change")
  status             UserStatus @default(INVITED)
  failedLoginCount   Int        @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp        String?    @map("last_login_ip") @db.Inet
  /// Non-null means MFA is mandatory for this user.
  mfaEnforcedAt      DateTime?  @map("mfa_enforced_at") @db.Timestamptz(6)
  isServiceAccount   Boolean    @default(false) @map("is_service_account")
  /// Bumped on password change, role change or "sign out everywhere". Access
  /// tokens carry it; a mismatch is a 401, so revocation is immediate.
  tokenEpoch         Int        @default(1) @map("token_epoch")
  termsAcceptedAt    DateTime?  @map("terms_accepted_at") @db.Timestamptz(6)
  disabledAt         DateTime?  @map("disabled_at") @db.Timestamptz(6)
  disabledReason     String?    @map("disabled_reason")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee       Employee?
  roles          UserRole[]           @relation("UserRoles")
  rolesGranted   UserRole[]           @relation("RoleGrantedBy")
  rolesRevoked   UserRole[]           @relation("RoleRevokedBy")
  refreshTokens  RefreshToken[]
  mfaCredentials MfaCredential[]
  recoveryCodes  MfaRecoveryCode[]
  loginAttempts  LoginAttempt[]
  resetTokens    PasswordResetToken[]
  notifications  Notification[]
  auditEvents    AuditEvent[]         @relation("AuditActor")

  @@unique([organizationId, email], map: "ux_app_user__org_email")
  @@index([organizationId, status], map: "ix_app_user__status")
  @@index([lockedUntil], map: "ix_app_user__locked")
  @@map("app_user")
  @@schema("ess")
}

/// Stable, non-sensitive identity. Effective-dated employment facts live in
/// EmployeeEmployment; encrypted personal facts in EmployeePersonalDetail.
model Employee {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  appUserId         String?          @unique @map("app_user_id") @db.Uuid
  employeeNumber    String           @map("employee_number") @db.Citext
  firstName         String           @map("first_name")
  middleName        String?          @map("middle_name")
  lastName          String           @map("last_name")
  /// Generated by the database: the Directory and Profile display name.
  fullName          String           @default(dbgenerated()) @map("full_name")
  preferredName     String?          @map("preferred_name")
  /// Generated by the database: avatar initials, so the UI never derives them.
  initials          String           @default(dbgenerated())
  workEmail         String           @map("work_email") @db.Citext
  /// A published work number, so not encrypted; still gated by directory:read.
  workPhone         String?          @map("work_phone")
  dateOfJoining     DateTime         @map("date_of_joining") @db.Date
  probationEndDate  DateTime?        @map("probation_end_date") @db.Date
  dateOfExit        DateTime?        @map("date_of_exit") @db.Date
  employmentStatus  EmploymentStatus @default(PRE_JOINING) @map("employment_status")
  isDirectoryListed Boolean          @default(true) @map("is_directory_listed")
  /// When null the UI renders `initials` on the department accent — never a stock image.
  photoFileObjectId String?          @map("photo_file_object_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion        Int              @default(1) @map("row_version")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  appUser      AppUser?     @relation(fields: [appUserId], references: [id], onDelete: SetNull)
  photo        FileObject?  @relation("EmployeePhoto", fields: [photoFileObjectId], references: [id], onDelete: SetNull)

  departmentsHeaded Department[]               @relation("DepartmentHead")
  employments       EmployeeEmployment[]
  managerLinks      EmployeeManager[]          @relation("EmployeeManagerSubject")
  reportLinks       EmployeeManager[]          @relation("EmployeeManagerManager")
  ancestorClosure   EmployeeReportingClosure[] @relation("ClosureDescendant")
  descendantClosure EmployeeReportingClosure[] @relation("ClosureAncestor")
  personalDetail    EmployeePersonalDetail?
  statutoryIds      EmployeeStatutoryId[]
  bankAccounts      EmployeeBankAccount[]
  emergencyContacts EmployeeEmergencyContact[]
  dependents        Dependent[]
  nominees          Nominee[]

  leaveBalances       LeaveBalance[]
  leaveLedger         LeaveBalanceLedger[]
  leaveRequests       LeaveRequest[]              @relation("LeaveRequester")
  attendanceRecords   AttendanceRecord[]
  attendanceApprovals AttendanceApproval[]        @relation("AttendanceApprover")
  salaryStructures    SalaryStructure[]
  payrollInputItems   PayrollInputItem[]
  payslips            Payslip[]
  payslipRollups      PayslipFyRollup[]
  validationResults   PayrollValidationResult[]
  taxElections        EmployeeTaxRegimeElection[]
  taxDeclarations     EmployeeTaxDeclaration[]
  taxProjections      EmployeeTaxProjection[]
  tdsQuarters         TdsQuarter[]
  form16s             Form16Document[]
  benefitEnrolments   BenefitEnrolment[]
  expenseClaims       ExpenseClaim[]              @relation("ExpenseClaimant")
  expenseRollups      ExpenseFyRollup[]
  documents           EmployeeDocument[]
  documentRequests    DocumentRequest[]           @relation("DocumentRequester")
  policyAssignments   PolicyAssignment[]
  acknowledgements    PolicyAcknowledgement[]
  announcementReads   AnnouncementRead[]
  ticketsRaised       HelpdeskTicket[]            @relation("TicketRequester")
  ticketsAssigned     HelpdeskTicket[]            @relation("TicketAssignee")
  ticketComments      TicketComment[]
  approvalTasks       ApprovalTask[]              @relation("ApprovalAssignee")
  approvalSubjects    ApprovalTask[]              @relation("ApprovalSubject")
  changeRequests      ProfileChangeRequest[]      @relation("ChangeRequestSubject")

  @@unique([organizationId, employeeNumber], map: "ux_employee__org_number")
  @@unique([organizationId, workEmail], map: "ux_employee__org_work_email")
  @@index([organizationId, employmentStatus], map: "ix_employee__org_status")
  @@index([organizationId, isDirectoryListed], map: "ix_employee__org_directory")
  @@map("employee")
  @@schema("ess")
}

/// Effective-dated employment facts. A promotion or transfer closes the current
/// row and opens a new one; history is never overwritten.
model EmployeeEmployment {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  employeeId       String         @map("employee_id") @db.Uuid
  departmentId     String         @map("department_id") @db.Uuid
  designationId    String         @map("designation_id") @db.Uuid
  locationId       String         @map("location_id") @db.Uuid
  costCentreId     String?        @map("cost_centre_id") @db.Uuid
  employmentType   EmploymentType @map("employment_type")
  noticePeriodDays Int            @default(0) @map("notice_period_days") @db.SmallInt
  effectiveFrom    DateTime       @map("effective_from") @db.Date
  /// Null means current. Exactly one open row per employee, enforced by an
  /// exclusion constraint in migration SQL.
  effectiveTo      DateTime?      @map("effective_to") @db.Date
  changeReason     String?        @map("change_reason")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department  Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation Designation @relation(fields: [designationId], references: [id], onDelete: Restrict)
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  costCentre  CostCentre? @relation(fields: [costCentreId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, effectiveFrom], map: "ix_employee_employment__org_emp_from")
  @@index([departmentId], map: "ix_employee_employment__department")
  @@map("employee_employment")
  @@schema("ess")
}

/// The reporting relationship, with history. Approval routing reads the row
/// current on the date of the request, not the row current today.
model EmployeeManager {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  employeeId        String    @map("employee_id") @db.Uuid
  managerEmployeeId String    @map("manager_employee_id") @db.Uuid
  /// A dotted-line manager does not receive approvals.
  isPrimary         Boolean   @default(true) @map("is_primary")
  effectiveFrom     DateTime  @map("effective_from") @db.Date
  effectiveTo       DateTime? @map("effective_to") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation("EmployeeManagerSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  manager  Employee @relation("EmployeeManagerManager", fields: [managerEmployeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, managerEmployeeId, effectiveTo], map: "ix_employee_manager__org_mgr")
  @@index([organizationId, employeeId, effectiveTo], map: "ix_employee_manager__org_emp")
  @@map("employee_manager")
  @@schema("ess")
}

/// Materialised reporting chain. Lets REPORTING_CHAIN scope be a single indexed
/// lookup instead of a recursive query on every authorization check. Rebuilt in
/// the same transaction as any change to employee_manager.
model EmployeeReportingClosure {
  organizationId       String   @map("organization_id") @db.Uuid
  ancestorEmployeeId   String   @map("ancestor_employee_id") @db.Uuid
  descendantEmployeeId String   @map("descendant_employee_id") @db.Uuid
  /// 0 for the employee themselves, 1 for a direct report.
  depth                Int      @db.SmallInt
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ancestor   Employee @relation("ClosureAncestor", fields: [ancestorEmployeeId], references: [id], onDelete: Cascade)
  descendant Employee @relation("ClosureDescendant", fields: [descendantEmployeeId], references: [id], onDelete: Cascade)

  @@id([ancestorEmployeeId, descendantEmployeeId])
  @@index([organizationId, ancestorEmployeeId, depth], map: "ix_closure__org_ancestor_depth")
  @@index([organizationId, descendantEmployeeId], map: "ix_closure__org_descendant")
  @@map("employee_reporting_closure")
  @@schema("ess")
}

/// Encrypted personal facts, one row per employee. Every `*Ct` column is an
/// AES-256-GCM ciphertext; the matching `*Iv`, `*Tag` and key version complete
/// the envelope. Nothing here is ever returned unmasked to another employee.
model EmployeePersonalDetail {
  employeeId     String @id @map("employee_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  dateOfBirth   DateTime?     @map("date_of_birth") @db.Date
  gender        Gender        @default(UNDISCLOSED)
  maritalStatus MaritalStatus @default(UNDISCLOSED) @map("marital_status")
  bloodGroup    BloodGroup    @default(UNKNOWN) @map("blood_group")
  nationality   String?

  personalEmailCt  Bytes? @map("personal_email_ct")
  personalEmailIv  Bytes? @map("personal_email_iv")
  personalEmailTag Bytes? @map("personal_email_tag")

  mobileCt  Bytes? @map("mobile_ct")
  mobileIv  Bytes? @map("mobile_iv")
  mobileTag Bytes? @map("mobile_tag")

  currentAddressCt  Bytes? @map("current_address_ct")
  currentAddressIv  Bytes? @map("current_address_iv")
  currentAddressTag Bytes? @map("current_address_tag")

  permanentAddressCt  Bytes? @map("permanent_address_ct")
  permanentAddressIv  Bytes? @map("permanent_address_iv")
  permanentAddressTag Bytes? @map("permanent_address_tag")

  /// Which KEK version sealed these values; drives lazy re-encryption on rotation.
  encryptionKeyVersion String   @default("v1") @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_personal_detail")
  @@schema("ess")
}

/// PAN, Aadhaar, UAN and the rest. The value is encrypted; `fingerprint` is a
/// keyed HMAC that makes uniqueness enforceable and lookup possible without
/// decrypting anything.
model EmployeeStatutoryId {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  employeeId           String          @map("employee_id") @db.Uuid
  kind                 StatutoryIdKind
  valueCt              Bytes           @map("value_ct")
  valueIv              Bytes           @map("value_iv")
  valueTag             Bytes           @map("value_tag")
  /// Masked form shown in the UI, e.g. `AXYPR••••K`. Derived at write time.
  maskedValue          String          @map("masked_value")
  /// HMAC-SHA256 of the normalised value. Unique per org and kind.
  fingerprint          String          @map("fingerprint")
  encryptionKeyVersion String          @default("v1") @map("encryption_key_version")
  verifiedAt           DateTime?       @map("verified_at") @db.Timestamptz(6)
  verifiedByUserId     String?         @map("verified_by_user_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, kind], map: "ux_employee_statutory_id__emp_kind")
  @@unique([organizationId, kind, fingerprint], map: "ux_employee_statutory_id__org_kind_fp")
  @@map("employee_statutory_id")
  @@schema("ess")
}

model EmployeeBankAccount {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  employeeId     String @map("employee_id") @db.Uuid
  bankName       String @map("bank_name")

  accountNumberCt          Bytes  @map("account_number_ct")
  accountNumberIv          Bytes  @map("account_number_iv")
  accountNumberTag         Bytes  @map("account_number_tag")
  /// `•• •••• •••• 4412` — what the Profile screen renders.
  accountNumberMasked      String @map("account_number_masked")
  accountNumberFingerprint String @map("account_number_fingerprint")

  ifscCt     Bytes  @map("ifsc_ct")
  ifscIv     Bytes  @map("ifsc_iv")
  ifscTag    Bytes  @map("ifsc_tag")
  ifscMasked String @map("ifsc_masked")

  accountHolderName    String    @map("account_holder_name")
  isPrimary            Boolean   @default(true) @map("is_primary")
  /// Payroll will not pay an unverified account — a blocking validation check.
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedByUserId     String?   @map("verified_by_user_id") @db.Uuid
  proofFileObjectId    String?   @map("proof_file_object_id") @db.Uuid
  encryptionKeyVersion String    @default("v1") @map("encryption_key_version")
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  proof    FileObject? @relation("BankProof", fields: [proofFileObjectId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, isActive], map: "ix_employee_bank__org_emp_active")
  @@map("employee_bank_account")
  @@schema("ess")
}

/// Visible only to the employee, their manager and HR.
model EmployeeEmergencyContact {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  employeeId           String   @map("employee_id") @db.Uuid
  name                 String
  relationship         String
  phoneCt              Bytes    @map("phone_ct")
  phoneIv              Bytes    @map("phone_iv")
  phoneTag             Bytes    @map("phone_tag")
  phoneMasked          String   @map("phone_masked")
  isPrimary            Boolean  @default(false) @map("is_primary")
  encryptionKeyVersion String   @default("v1") @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId], map: "ix_emergency_contact__org_emp")
  @@map("employee_emergency_contact")
  @@schema("ess")
}

// ═══════════════════════════════════════════════════════════════════════════
// Sessions, MFA and login security
// ═══════════════════════════════════════════════════════════════════════════

/// Rotating refresh tokens. Only the hash is stored. Every rotation issues a new
/// row in the same family; presenting an already-rotated token means the token
/// was stolen, so the whole family is revoked and the user is told.
model RefreshToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  appUserId      String    @map("app_user_id") @db.Uuid
  /// Shared by every token descended from one sign-in.
  familyId       String    @map("family_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  /// The token this one replaced, for reuse detection.
  parentId       String?   @map("parent_id") @db.Uuid
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt      DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason  String?   @map("revoked_reason")
  ip             String?   @db.Inet
  userAgent      String?   @map("user_agent")
  /// Stable per-device hint so a user can recognise their own sessions.
  deviceLabel    String?   @map("device_label")

  user   AppUser        @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  parent RefreshToken?  @relation("TokenRotation", fields: [parentId], references: [id], onDelete: SetNull)
  child  RefreshToken[] @relation("TokenRotation")

  @@index([appUserId, revokedAt], map: "ix_refresh_token__user_active")
  @@index([familyId], map: "ix_refresh_token__family")
  @@index([expiresAt], map: "ix_refresh_token__expiry")
  @@map("refresh_token")
  @@schema("ess")
}

model MfaCredential {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  appUserId            String    @map("app_user_id") @db.Uuid
  method               MfaMethod @default(TOTP)
  secretCt             Bytes     @map("secret_ct")
  secretIv             Bytes     @map("secret_iv")
  secretTag            Bytes     @map("secret_tag")
  encryptionKeyVersion String    @default("v1") @map("encryption_key_version")
  /// The last accepted TOTP step, so a code cannot be replayed inside its window.
  lastUsedTimeStep     BigInt?   @map("last_used_time_step")
  confirmedAt          DateTime? @map("confirmed_at") @db.Timestamptz(6)
  disabledAt           DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@unique([appUserId, method], map: "ux_mfa_credential__user_method")
  @@map("mfa_credential")
  @@schema("ess")
}

/// Single-use recovery codes, stored as Argon2 hashes. The server can check one
/// but can never show it again.
model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appUserId String    @map("app_user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  usedIp    String?   @map("used_ip") @db.Inet
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId, usedAt], map: "ix_mfa_recovery__user_unused")
  @@map("mfa_recovery_code")
  @@schema("ess")
}

/// Every sign-in attempt, successful or not. Drives progressive lockout and the
/// "new sign-in" security notification, and is the evidence trail for an
/// investigation.
model LoginAttempt {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  appUserId      String?      @map("app_user_id") @db.Uuid
  /// Stored even when no user matched, so enumeration attempts are visible.
  emailAttempted String       @map("email_attempted") @db.Citext
  outcome        LoginOutcome
  ip             String?      @db.Inet
  userAgent      String?      @map("user_agent")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser? @relation(fields: [appUserId], references: [id], onDelete: SetNull)

  @@index([emailAttempted, createdAt], map: "ix_login_attempt__email_time")
  @@index([ip, createdAt], map: "ix_login_attempt__ip_time")
  @@index([appUserId, createdAt], map: "ix_login_attempt__user_time")
  @@map("login_attempt")
  @@schema("ess")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appUserId String    @map("app_user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  ip        String?   @db.Inet
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId, usedAt], map: "ix_password_reset__user_unused")
  @@index([expiresAt], map: "ix_password_reset__expiry")
  @@map("password_reset_token")
  @@schema("ess")
}

// ═══════════════════════════════════════════════════════════════════════════
// Calendar, leave and attendance
// ═══════════════════════════════════════════════════════════════════════════

model HolidayCalendar {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  year           Int
  /// ISO weekday numbers that are week-offs: [6,7] for Sat/Sun.
  weekOffDays    Int[]    @map("week_off_days")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  holidays     Holiday[]
  locations    Location[]

  @@unique([organizationId, name, year], map: "ux_holiday_calendar__org_name_year")
  @@map("holiday_calendar")
  @@schema("ess")
}

model Holiday {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  holidayCalendarId String      @map("holiday_calendar_id") @db.Uuid
  date              DateTime    @db.Date
  name              String
  kind              HolidayKind @default(PUBLIC)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  calendar HolidayCalendar @relation(fields: [holidayCalendarId], references: [id], onDelete: Cascade)

  @@unique([holidayCalendarId, date, name], map: "ux_holiday__calendar_date_name")
  @@index([organizationId, date], map: "ix_holiday__org_date")
  @@map("holiday")
  @@schema("ess")
}

/// Reference data, seeded. Earned, casual, sick, comp-off, restricted holiday.
model LeaveType {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId            String                @map("organization_id") @db.Uuid
  code                      String                @db.Citext
  name                      String
  unit                      LeaveUnit             @default(DAY)
  accrualFrequency          LeaveAccrualFrequency @default(MONTHLY) @map("accrual_frequency")
  /// Days added per accrual event, e.g. 1.50 monthly for earned leave.
  accrualDays               Decimal               @default(0) @map("accrual_days") @db.Decimal(5, 2)
  maxCarryForwardDays       Decimal               @default(0) @map("max_carry_forward_days") @db.Decimal(5, 2)
  /// Unpaid leave becomes loss of pay in the attendance period.
  isPaid                    Boolean               @default(true) @map("is_paid")
  requiresApproval          Boolean               @default(true) @map("requires_approval")
  /// Working days of notice expected before a planned request.
  minNoticeDays             Int                   @default(0) @map("min_notice_days") @db.SmallInt
  /// Consecutive days beyond which a medical certificate is required.
  documentRequiredAfterDays Int?                  @map("document_required_after_days") @db.SmallInt
  allowsHalfDay             Boolean               @default(true) @map("allows_half_day")
  /// Ordering on the Leave screen's balance cards.
  displayOrder              Int                   @default(0) @map("display_order") @db.SmallInt
  isActive                  Boolean               @default(true) @map("is_active")
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  balances     LeaveBalance[]
  ledger       LeaveBalanceLedger[]
  requests     LeaveRequest[]

  @@unique([organizationId, code], map: "ux_leave_type__org_code")
  @@map("leave_type")
  @@schema("ess")
}

/// The leave year. Balances are scoped to it, so a lapse or carry-forward is a
/// ledger entry rather than a silent reset.
model LeavePeriod {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  isClosed       Boolean  @default(false) @map("is_closed")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  balances     LeaveBalance[]
  ledger       LeaveBalanceLedger[]
  requests     LeaveRequest[]

  @@unique([organizationId, startDate], map: "ux_leave_period__org_start")
  @@map("leave_period")
  @@schema("ess")
}

/// Append-only ledger. Every movement of leave — accrual, consumption,
/// reversal, lapse, adjustment — is a row, so a balance can always be explained.
model LeaveBalanceLedger {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  employeeId      String          @map("employee_id") @db.Uuid
  leaveTypeId     String          @map("leave_type_id") @db.Uuid
  leavePeriodId   String          @map("leave_period_id") @db.Uuid
  kind            LeaveLedgerKind
  /// Signed: positive credits, negative consumes.
  deltaDays       Decimal         @map("delta_days") @db.Decimal(6, 2)
  /// What caused it, e.g. a leave request id. Makes every row traceable.
  sourceType      String?         @map("source_type")
  sourceId        String?         @map("source_id") @db.Uuid
  note            String?
  effectiveOn     DateTime        @map("effective_on") @db.Date
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  employee  Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  period    LeavePeriod @relation(fields: [leavePeriodId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, leaveTypeId, leavePeriodId], map: "ix_leave_ledger__org_emp_type_period")
  @@index([sourceType, sourceId], map: "ix_leave_ledger__source")
  @@map("leave_balance_ledger")
  @@schema("ess")
}

/// Projection of the ledger, maintained in the same transaction. The Leave
/// screen reads this; it never sums the ledger at render time and never shows a
/// balance the ledger cannot justify.
model LeaveBalance {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  employeeId         String   @map("employee_id") @db.Uuid
  leaveTypeId        String   @map("leave_type_id") @db.Uuid
  leavePeriodId      String   @map("leave_period_id") @db.Uuid
  openingDays        Decimal  @default(0) @map("opening_days") @db.Decimal(6, 2)
  accruedDays        Decimal  @default(0) @map("accrued_days") @db.Decimal(6, 2)
  carriedForwardDays Decimal  @default(0) @map("carried_forward_days") @db.Decimal(6, 2)
  consumedDays       Decimal  @default(0) @map("consumed_days") @db.Decimal(6, 2)
  /// Held by submitted-but-undecided requests, so a balance cannot be spent twice.
  reservedDays       Decimal  @default(0) @map("reserved_days") @db.Decimal(6, 2)
  lapsedDays         Decimal  @default(0) @map("lapsed_days") @db.Decimal(6, 2)
  adjustedDays       Decimal  @default(0) @map("adjusted_days") @db.Decimal(6, 2)
  /// Generated by the database: opening + accrued + carried + adjusted,
  /// less consumed, reserved and lapsed.
  availableDays      Decimal  @default(dbgenerated()) @map("available_days") @db.Decimal(6, 2)
  /// Entitlement for the period, the denominator of the Leave screen's bar.
  entitlementDays    Decimal  @default(0) @map("entitlement_days") @db.Decimal(6, 2)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee  Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  period    LeavePeriod @relation(fields: [leavePeriodId], references: [id], onDelete: Restrict)

  @@unique([employeeId, leaveTypeId, leavePeriodId], map: "ux_leave_balance__emp_type_period")
  @@index([organizationId, leavePeriodId], map: "ix_leave_balance__org_period")
  @@map("leave_balance")
  @@schema("ess")
}

model LeaveRequest {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  employeeId           String             @map("employee_id") @db.Uuid
  leaveTypeId          String             @map("leave_type_id") @db.Uuid
  leavePeriodId        String             @map("leave_period_id") @db.Uuid
  status               LeaveRequestStatus @default(DRAFT)
  startDate            DateTime           @map("start_date") @db.Date
  endDate              DateTime           @map("end_date") @db.Date
  startPortion         LeaveDayPortion    @default(FULL) @map("start_portion")
  endPortion           LeaveDayPortion    @default(FULL) @map("end_portion")
  /// Computed server-side against weekends and the holiday calendar. The client
  /// never supplies a day count.
  workingDays          Decimal            @map("working_days") @db.Decimal(5, 2)
  reason               String?
  /// Denormalised at submission so routing survives a later manager change.
  approverEmployeeId   String?            @map("approver_employee_id") @db.Uuid
  submittedAt          DateTime?          @map("submitted_at") @db.Timestamptz(6)
  decidedAt            DateTime?          @map("decided_at") @db.Timestamptz(6)
  decidedByUserId      String?            @map("decided_by_user_id") @db.Uuid
  decisionNote         String?            @map("decision_note")
  withdrawnAt          DateTime?          @map("withdrawn_at") @db.Timestamptz(6)
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  documentFileObjectId String?            @map("document_file_object_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion           Int                @default(1) @map("row_version")

  employee  Employee          @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType         @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  period    LeavePeriod       @relation(fields: [leavePeriodId], references: [id], onDelete: Restrict)
  document  FileObject?       @relation("LeaveDocument", fields: [documentFileObjectId], references: [id], onDelete: SetNull)
  days      LeaveRequestDay[]

  @@index([organizationId, employeeId, status], map: "ix_leave_request__org_emp_status")
  @@index([organizationId, approverEmployeeId, status], map: "ix_leave_request__org_approver_status")
  @@index([organizationId, startDate, endDate], map: "ix_leave_request__org_dates")
  @@map("leave_request")
  @@schema("ess")
}

/// One row per calendar day of an approved or pending request. This is what the
/// attendance period reads to classify a day, so leave and attendance can never
/// disagree.
model LeaveRequestDay {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  leaveRequestId String          @map("leave_request_id") @db.Uuid
  date           DateTime        @db.Date
  portion        LeaveDayPortion @default(FULL)
  /// 1.00 for a full day, 0.50 for a half day.
  dayFraction    Decimal         @map("day_fraction") @db.Decimal(3, 2)

  request LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, date], map: "ux_leave_request_day__request_date")
  @@index([organizationId, date], map: "ix_leave_request_day__org_date")
  @@map("leave_request_day")
  @@schema("ess")
}

/// A month of attendance. HR fills it, submits it, and every affected manager
/// approves their slice before payroll may consume it.
model AttendancePeriod {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                 @map("organization_id") @db.Uuid
  year              Int                    @db.SmallInt
  month             Int                    @db.SmallInt
  startDate         DateTime               @map("start_date") @db.Date
  endDate           DateTime               @map("end_date") @db.Date
  /// Calendar days in the period — the denominator for proration.
  totalDays         Int                    @map("total_days") @db.SmallInt
  status            AttendancePeriodStatus @default(OPEN)
  submittedAt       DateTime?              @map("submitted_at") @db.Timestamptz(6)
  submittedByUserId String?                @map("submitted_by_user_id") @db.Uuid
  approvedAt        DateTime?              @map("approved_at") @db.Timestamptz(6)
  lockedAt          DateTime?              @map("locked_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion        Int                    @default(1) @map("row_version")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  records      AttendanceRecord[]
  submissions  AttendanceSubmission[]
  approvals    AttendanceApproval[]
  payrollCycle PayrollCycle?

  @@unique([organizationId, year, month], map: "ux_attendance_period__org_year_month")
  @@index([organizationId, status], map: "ix_attendance_period__org_status")
  @@map("attendance_period")
  @@schema("ess")
}

/// One row per employee per period. Day counts are computed from leave and the
/// holiday calendar, then confirmed by HR and the manager — never guessed.
model AttendanceRecord {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                 @map("organization_id") @db.Uuid
  attendancePeriodId String                 @map("attendance_period_id") @db.Uuid
  employeeId         String                 @map("employee_id") @db.Uuid
  /// Denormalised at submission so a later reorg cannot re-route an approval.
  managerEmployeeId  String?                @map("manager_employee_id") @db.Uuid
  status             AttendanceRecordStatus @default(DRAFT)
  source             AttendanceSource       @default(SYSTEM_DERIVED)

  presentDays     Decimal @default(0) @map("present_days") @db.Decimal(5, 2)
  paidLeaveDays   Decimal @default(0) @map("paid_leave_days") @db.Decimal(5, 2)
  unpaidLeaveDays Decimal @default(0) @map("unpaid_leave_days") @db.Decimal(5, 2)
  holidayDays     Decimal @default(0) @map("holiday_days") @db.Decimal(5, 2)
  weekOffDays     Decimal @default(0) @map("week_off_days") @db.Decimal(5, 2)
  absentDays      Decimal @default(0) @map("absent_days") @db.Decimal(5, 2)
  /// Generated by the database: present + paid leave + holiday + week-off.
  /// The numerator of every proration.
  payableDays     Decimal @default(dbgenerated()) @map("payable_days") @db.Decimal(5, 2)
  /// Generated by the database: unpaid leave + absent. Loss of pay.
  lopDays         Decimal @default(dbgenerated()) @map("lop_days") @db.Decimal(5, 2)
  /// Days the employee was actually on the rolls this period (joiners/leavers).
  employedDays    Int     @map("employed_days") @db.SmallInt

  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion Int      @default(1) @map("row_version")

  period   AttendancePeriod @relation(fields: [attendancePeriodId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([attendancePeriodId, employeeId], map: "ux_attendance_record__period_emp")
  @@index([organizationId, managerEmployeeId, status], map: "ix_attendance_record__org_mgr_status")
  @@index([organizationId, employeeId], map: "ix_attendance_record__org_emp")
  @@map("attendance_record")
  @@schema("ess")
}

/// The HR act: submitting a period for manager review. Recorded separately from
/// the period so a resubmission after a return keeps its own trail.
model AttendanceSubmission {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  attendancePeriodId String   @map("attendance_period_id") @db.Uuid
  submittedByUserId  String   @map("submitted_by_user_id") @db.Uuid
  /// How many employee records this submission covered.
  recordCount        Int      @map("record_count")
  /// Incremented on each resubmission after a manager return.
  attempt            Int      @default(1)
  note               String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  period AttendancePeriod @relation(fields: [attendancePeriodId], references: [id], onDelete: Cascade)

  @@index([organizationId, attendancePeriodId], map: "ix_attendance_submission__org_period")
  @@map("attendance_submission")
  @@schema("ess")
}

/// The Manager act, one row per manager per period. The period reaches APPROVED
/// only when no PENDING row remains, so "who still owes an approval" is a query,
/// never a guess.
model AttendanceApproval {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                   @map("organization_id") @db.Uuid
  attendancePeriodId String                   @map("attendance_period_id") @db.Uuid
  managerEmployeeId  String                   @map("manager_employee_id") @db.Uuid
  status             AttendanceApprovalStatus @default(PENDING)
  /// Employee records in this manager's slice.
  recordCount        Int                      @map("record_count")
  decidedAt          DateTime?                @map("decided_at") @db.Timestamptz(6)
  decidedByUserId    String?                  @map("decided_by_user_id") @db.Uuid
  /// Required when the slice is returned, so HR knows what to correct.
  returnReason       String?                  @map("return_reason")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion         Int                      @default(1) @map("row_version")

  period  AttendancePeriod @relation(fields: [attendancePeriodId], references: [id], onDelete: Cascade)
  manager Employee         @relation("AttendanceApprover", fields: [managerEmployeeId], references: [id], onDelete: Restrict)

  @@unique([attendancePeriodId, managerEmployeeId], map: "ux_attendance_approval__period_mgr")
  @@index([organizationId, managerEmployeeId, status], map: "ix_attendance_approval__org_mgr_status")
  @@map("attendance_approval")
  @@schema("ess")
}

// ═══════════════════════════════════════════════════════════════════════════
// Payroll
//
// The pipeline is: Accounts uploads payroll data → HR submits attendance →
// the respective Manager approves it → the system validates the inputs →
// payroll generates → the payslip becomes visible to the employee.
//
// A payslip row cannot exist before the cycle is CALCULATED, and cannot be read
// by its employee before the cycle is PUBLISHED. That is enforced three times
// over: by this schema's check constraints (in migration SQL), by the service
// layer's state machine, and by the authorization check on the route.
// ═══════════════════════════════════════════════════════════════════════════

model PayrollCycle {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  year               Int                @db.SmallInt
  month              Int                @db.SmallInt
  /// `August 2026` — the label the Payslips list shows.
  label              String
  periodStart        DateTime           @map("period_start") @db.Date
  periodEnd          DateTime           @map("period_end") @db.Date
  payDate            DateTime           @map("pay_date") @db.Date
  status             PayrollCycleStatus @default(DRAFT)
  runType            PayrollRunTypeEnum @default(REGULAR) @map("run_type")
  /// The attendance period this cycle consumes. Required before validation.
  attendancePeriodId String?            @unique @map("attendance_period_id") @db.Uuid
  /// A supplementary run corrects an earlier cycle rather than replacing it.
  supersedesCycleId  String?            @map("supersedes_cycle_id") @db.Uuid

  inputsLockedAt        DateTime? @map("inputs_locked_at") @db.Timestamptz(6)
  attendanceSubmittedAt DateTime? @map("attendance_submitted_at") @db.Timestamptz(6)
  attendanceApprovedAt  DateTime? @map("attendance_approved_at") @db.Timestamptz(6)
  validatedAt           DateTime? @map("validated_at") @db.Timestamptz(6)
  calculatedAt          DateTime? @map("calculated_at") @db.Timestamptz(6)
  approvedAt            DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedByUserId      String?   @map("approved_by_user_id") @db.Uuid
  publishedAt           DateTime? @map("published_at") @db.Timestamptz(6)
  publishedByUserId     String?   @map("published_by_user_id") @db.Uuid
  closedAt              DateTime? @map("closed_at") @db.Timestamptz(6)
  cancelledAt           DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason          String?   @map("cancel_reason")

  /// Headcount in scope, recorded at validation so the run is reproducible.
  employeeCount       Int?    @map("employee_count")
  /// Employees excluded by a blocking validation failure, with reasons on
  /// PayrollValidationResult. Never silently dropped.
  excludedCount       Int?    @map("excluded_count")
  totalGrossMinor     BigInt? @map("total_gross_minor")
  totalDeductionMinor BigInt? @map("total_deduction_minor")
  totalNetMinor       BigInt? @map("total_net_minor")

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion Int      @default(1) @map("row_version")

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attendancePeriod     AttendancePeriod?         @relation(fields: [attendancePeriodId], references: [id], onDelete: Restrict)
  supersedes           PayrollCycle?             @relation("CycleSupersedes", fields: [supersedesCycleId], references: [id], onDelete: Restrict)
  supersededBy         PayrollCycle[]            @relation("CycleSupersedes")
  inputBatches         PayrollInputBatch[]
  validationResults    PayrollValidationResult[]
  runs                 PayrollRun[]
  payslips             Payslip[]
  reimbursementBatches ReimbursementBatch[]

  @@unique([organizationId, year, month, runType, supersedesCycleId], map: "ux_payroll_cycle__org_period_run")
  @@index([organizationId, status], map: "ix_payroll_cycle__org_status")
  @@index([organizationId, year, month], map: "ix_payroll_cycle__org_year_month")
  @@map("payroll_cycle")
  @@schema("ess")
}

enum PayrollRunTypeEnum {
  REGULAR
  SUPPLEMENTARY
  OFF_CYCLE

  @@map("ess_payroll_run_type")
  @@schema("ess")
}

/// Reference data, seeded. Basic, HRA, special allowance, PF, professional tax
/// and the rest — each with how it is calculated and where it sits on a payslip.
model PayComponent {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  code           String           @db.Citext
  name           String
  kind           PayComponentKind
  calc           PayComponentCalc
  /// Rate for a percentage component, e.g. 0.120000 for PF at 12% of basic.
  rate           Decimal?         @db.Decimal(12, 6)
  /// Statutory ceiling in paise, e.g. the PF wage ceiling of ₹15,000.
  ceilingMinor   BigInt?          @map("ceiling_minor")
  /// Does loss of pay reduce it? Basic and HRA yes; a fixed reimbursement no.
  isProrated     Boolean          @default(true) @map("is_prorated")
  isTaxable      Boolean          @default(true) @map("is_taxable")
  /// Counted in the PF wage base.
  isPfApplicable Boolean          @default(false) @map("is_pf_applicable")
  /// Order on the payslip, so two runs never list components differently.
  displayOrder   Int              @default(0) @map("display_order") @db.SmallInt
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  structureComponents SalaryStructureComponent[]
  payslipLines        PayslipLine[]
  inputItems          PayrollInputItem[]

  @@unique([organizationId, code], map: "ux_pay_component__org_code")
  @@map("pay_component")
  @@schema("ess")
}

/// An employee's salary structure, effective-dated. A revision opens a new row;
/// the old one is closed, never edited, so an old payslip stays explicable.
model SalaryStructure {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  /// Annual cost to company, in paise.
  annualCtcMinor   BigInt    @map("annual_ctc_minor")
  revisionReason   String?   @map("revision_reason")
  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee   Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  components SalaryStructureComponent[]

  @@index([organizationId, employeeId, effectiveFrom], map: "ix_salary_structure__org_emp_from")
  @@map("salary_structure")
  @@schema("ess")
}

model SalaryStructureComponent {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  salaryStructureId  String   @map("salary_structure_id") @db.Uuid
  payComponentId     String   @map("pay_component_id") @db.Uuid
  /// Monthly amount in paise for a fixed component.
  monthlyAmountMinor BigInt?  @map("monthly_amount_minor")
  /// Rate override for this employee, where the component is percentage-based.
  rateOverride       Decimal? @map("rate_override") @db.Decimal(12, 6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  structure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  component PayComponent    @relation(fields: [payComponentId], references: [id], onDelete: Restrict)

  @@unique([salaryStructureId, payComponentId], map: "ux_structure_component__structure_component")
  @@map("salary_structure_component")
  @@schema("ess")
}

/// An Accounts upload. Rows are parsed and validated before anything is
/// committed, so a bad file never half-applies.
model PayrollInputBatch {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  payrollCycleId      String                  @map("payroll_cycle_id") @db.Uuid
  status              PayrollInputBatchStatus @default(UPLOADING)
  fileObjectId        String?                 @map("file_object_id") @db.Uuid
  originalFilename    String?                 @map("original_filename")
  rowCount            Int                     @default(0) @map("row_count")
  acceptedCount       Int                     @default(0) @map("accepted_count")
  rejectedCount       Int                     @default(0) @map("rejected_count")
  /// Per-row parse and validation errors, so Accounts can fix and re-upload.
  parseErrors         Json?                   @map("parse_errors")
  uploadedByUserId    String                  @map("uploaded_by_user_id") @db.Uuid
  committedAt         DateTime?               @map("committed_at") @db.Timestamptz(6)
  supersededByBatchId String?                 @map("superseded_by_batch_id") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cycle        PayrollCycle        @relation(fields: [payrollCycleId], references: [id], onDelete: Cascade)
  file         FileObject?         @relation("PayrollInputFile", fields: [fileObjectId], references: [id], onDelete: SetNull)
  items        PayrollInputItem[]
  supersededBy PayrollInputBatch?  @relation("BatchSupersedes", fields: [supersededByBatchId], references: [id], onDelete: SetNull)
  supersedes   PayrollInputBatch[] @relation("BatchSupersedes")

  @@index([organizationId, payrollCycleId, status], map: "ix_payroll_input_batch__org_cycle_status")
  @@map("payroll_input_batch")
  @@schema("ess")
}

/// One payroll input for one employee: an incentive, an arrear, a one-off
/// deduction, a loss-of-pay override. Every payslip line that is not derived
/// from the salary structure traces back to one of these.
model PayrollInputItem {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  payrollInputBatchId String           @map("payroll_input_batch_id") @db.Uuid
  employeeId          String           @map("employee_id") @db.Uuid
  kind                PayrollInputKind
  payComponentId      String?          @map("pay_component_id") @db.Uuid
  /// Signed: an arrear is positive, a recovery negative.
  amountMinor         BigInt?          @map("amount_minor")
  /// For LOP_OVERRIDE: days to treat as loss of pay, overriding attendance.
  days                Decimal?         @db.Decimal(5, 2)
  note                String?
  /// The row number in the uploaded file, so an error points somewhere real.
  sourceRowNumber     Int?             @map("source_row_number")
  isApplied           Boolean          @default(false) @map("is_applied")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  batch     PayrollInputBatch @relation(fields: [payrollInputBatchId], references: [id], onDelete: Cascade)
  employee  Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  component PayComponent?     @relation(fields: [payComponentId], references: [id], onDelete: Restrict)

  @@index([organizationId, payrollInputBatchId], map: "ix_payroll_input_item__org_batch")
  @@index([organizationId, employeeId], map: "ix_payroll_input_item__org_emp")
  @@map("payroll_input_item")
  @@schema("ess")
}

/// The outcome of one validation check for one employee. Persisted so the
/// Accounts validation report shows real findings, and so an exclusion from a
/// run always carries a recorded reason.
model PayrollValidationResult {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  payrollCycleId String                    @map("payroll_cycle_id") @db.Uuid
  employeeId     String?                   @map("employee_id") @db.Uuid
  /// One of PAYROLL_VALIDATION_CHECKS in packages/shared.
  check          String
  severity       PayrollValidationSeverity
  passed         Boolean
  message        String
  /// What Accounts or HR must do to clear it.
  remedy         String?
  /// Which run of validation produced this, so an old finding is not mistaken
  /// for a current one.
  attempt        Int                       @default(1)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  cycle    PayrollCycle @relation(fields: [payrollCycleId], references: [id], onDelete: Cascade)
  employee Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, payrollCycleId, passed], map: "ix_payroll_validation__org_cycle_passed")
  @@index([organizationId, payrollCycleId, employeeId], map: "ix_payroll_validation__org_cycle_emp")
  @@map("payroll_validation_result")
  @@schema("ess")
}

/// One execution of the calculation engine. Records the engine version and the
/// input digest, so a payslip can always be tied to the code and data that
/// produced it.
model PayrollRun {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  payrollCycleId    String           @map("payroll_cycle_id") @db.Uuid
  status            PayrollRunStatus @default(QUEUED)
  attempt           Int              @default(1)
  /// Version of the calculation engine, so a rule change is visible in history.
  engineVersion     String           @map("engine_version")
  /// SHA-256 over every input the run consumed. Two runs with the same digest
  /// must produce identical output.
  inputDigest       String?          @map("input_digest")
  startedAt         DateTime?        @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime?        @map("finished_at") @db.Timestamptz(6)
  employeeCount     Int?             @map("employee_count")
  errorMessage      String?          @map("error_message")
  triggeredByUserId String           @map("triggered_by_user_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  cycle    PayrollCycle @relation(fields: [payrollCycleId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@index([organizationId, payrollCycleId, status], map: "ix_payroll_run__org_cycle_status")
  @@map("payroll_run")
  @@schema("ess")
}

/// Immutable once generated. A correction never edits a payslip — it issues a
/// new version and marks the old one SUPERSEDED, so what an employee downloaded
/// last month still exists exactly as they saw it.
model Payslip {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  payrollCycleId      String        @map("payroll_cycle_id") @db.Uuid
  payrollRunId        String        @map("payroll_run_id") @db.Uuid
  employeeId          String        @map("employee_id") @db.Uuid
  status              PayslipStatus @default(GENERATED)
  /// `WDT-PS-2608-1847` — stable, unique, printed on the PDF.
  reference           String        @db.Citext
  version             Int           @default(1)
  supersedesPayslipId String?       @map("supersedes_payslip_id") @db.Uuid

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  payDate     DateTime @map("pay_date") @db.Date

  /// From the approved attendance record — the proration the run actually used.
  payableDays Decimal @map("payable_days") @db.Decimal(5, 2)
  totalDays   Int     @map("total_days") @db.SmallInt
  lopDays     Decimal @map("lop_days") @db.Decimal(5, 2)

  grossEarningsMinor        BigInt @map("gross_earnings_minor")
  totalDeductionsMinor      BigInt @map("total_deductions_minor")
  netPayMinor               BigInt @map("net_pay_minor")
  employerContributionMinor BigInt @default(0) @map("employer_contribution_minor")
  /// Broken out because the Payslips and Tax screens show them directly.
  pfEmployeeMinor           BigInt @default(0) @map("pf_employee_minor")
  pfEmployerMinor           BigInt @default(0) @map("pf_employer_minor")
  tdsMinor                  BigInt @default(0) @map("tds_minor")
  professionalTaxMinor      BigInt @default(0) @map("professional_tax_minor")

  /// SHA-256 over every input that produced this payslip — salary structure,
  /// attendance, payroll inputs, tax election, engine version. Recomputing the
  /// run from the same inputs must reproduce this digest.
  sourceDigest    String  @map("source_digest")
  /// The stored PDF. Null until rendering completes; the UI offers a download
  /// only when this is present rather than promising a file that does not exist.
  pdfFileObjectId String? @map("pdf_file_object_id") @db.Uuid

  generatedAt  DateTime  @default(now()) @map("generated_at") @db.Timestamptz(6)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason String?   @map("revoke_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  cycle        PayrollCycle         @relation(fields: [payrollCycleId], references: [id], onDelete: Restrict)
  run          PayrollRun           @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  pdf          FileObject?          @relation("PayslipPdf", fields: [pdfFileObjectId], references: [id], onDelete: SetNull)
  supersedes   Payslip?             @relation("PayslipSupersedes", fields: [supersedesPayslipId], references: [id], onDelete: Restrict)
  supersededBy Payslip[]            @relation("PayslipSupersedes")
  lines        PayslipLine[]
  publications PayslipPublication[]

  @@unique([organizationId, reference], map: "ux_payslip__org_reference")
  @@unique([payrollCycleId, employeeId, version], map: "ux_payslip__cycle_emp_version")
  @@index([organizationId, employeeId, status], map: "ix_payslip__org_emp_status")
  @@index([organizationId, payrollCycleId], map: "ix_payslip__org_cycle")
  @@map("payslip")
  @@schema("ess")
}

/// One earning or deduction line. Written once with the payslip and never
/// updated — the amount an employee saw is the amount that stays on record.
model PayslipLine {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  payslipId          String          @map("payslip_id") @db.Uuid
  payComponentId     String?         @map("pay_component_id") @db.Uuid
  kind               PayslipLineKind
  /// Snapshot of the component name, so renaming a component later does not
  /// rewrite history.
  label              String
  amountMinor        BigInt          @map("amount_minor")
  /// The unprorated entitlement, where loss of pay reduced this line.
  fullAmountMinor    BigInt?         @map("full_amount_minor")
  displayOrder       Int             @map("display_order") @db.SmallInt
  /// Which payroll input produced this line, where it was not derived from the
  /// salary structure.
  payrollInputItemId String?         @map("payroll_input_item_id") @db.Uuid
  /// Human-readable derivation, e.g. "12% of basic (capped at the PF ceiling)".
  calculationNote    String?         @map("calculation_note")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  payslip   Payslip       @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  component PayComponent? @relation(fields: [payComponentId], references: [id], onDelete: Restrict)

  @@index([payslipId, displayOrder], map: "ix_payslip_line__payslip_order")
  @@map("payslip_line")
  @@schema("ess")
}

/// The act of making a payslip visible, recorded separately from the payslip so
/// the moment an employee could first see it is independently auditable.
model PayslipPublication {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  payslipId         String   @map("payslip_id") @db.Uuid
  publishedByUserId String   @map("published_by_user_id") @db.Uuid
  publishedAt       DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  /// Whether the employee was emailed, and whether that email was delivered.
  notificationSent  Boolean  @default(false) @map("notification_sent")
  emailOutboxId     String?  @map("email_outbox_id") @db.Uuid

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([organizationId, payslipId], map: "ix_payslip_publication__org_payslip")
  @@map("payslip_publication")
  @@schema("ess")
}

/// Year-to-date totals, maintained as payslips publish. The Payslips screen's
/// four YTD tiles read this, so they never sum encrypted rows at render time —
/// and never show a figure no payslip supports.
model PayslipFyRollup {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  fiscalYearId    String   @map("fiscal_year_id") @db.Uuid
  payslipCount    Int      @default(0) @map("payslip_count")
  grossMinor      BigInt   @default(0) @map("gross_minor")
  netMinor        BigInt   @default(0) @map("net_minor")
  tdsMinor        BigInt   @default(0) @map("tds_minor")
  pfEmployeeMinor BigInt   @default(0) @map("pf_employee_minor")
  pfEmployerMinor BigInt   @default(0) @map("pf_employer_minor")
  /// The months covered, e.g. `Apr – Aug 2026`. Derived from the payslips, so
  /// the caption under each tile is as real as the number above it.
  coverageLabel   String?  @map("coverage_label")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@unique([employeeId, fiscalYearId], map: "ux_payslip_rollup__emp_fy")
  @@index([organizationId, fiscalYearId], map: "ix_payslip_rollup__org_fy")
  @@map("payslip_fy_rollup")
  @@schema("ess")
}

// ═══════════════════════════════════════════════════════════════════════════
// Tax
// ═══════════════════════════════════════════════════════════════════════════

/// Reference data, seeded. Slabs and rules per regime per financial year.
model TaxRegime {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                   TaxRegimeCode
  fiscalYearStartYear    Int           @map("fiscal_year_start_year")
  name                   String
  /// Ordered slab definitions: upper bound in paise and the rate above it.
  slabs                  Json
  standardDeductionMinor BigInt        @default(0) @map("standard_deduction_minor")
  /// Rebate under section 87A: threshold and maximum, in paise.
  rebateThresholdMinor   BigInt?       @map("rebate_threshold_minor")
  rebateMaxMinor         BigInt?       @map("rebate_max_minor")
  cessRate               Decimal       @default(0.04) @map("cess_rate") @db.Decimal(12, 6)
  /// Whether chapter VI-A deductions may be claimed under this regime.
  allowsDeductions       Boolean       @default(true) @map("allows_deductions")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  elections EmployeeTaxRegimeElection[]

  @@unique([code, fiscalYearStartYear], map: "ux_tax_regime__code_fy")
  @@map("tax_regime")
  @@schema("ess")
}

/// Which regime an employee elected for a financial year. Payroll will not run
/// without one — it is a blocking validation check, never a silent default.
model EmployeeTaxRegimeElection {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  employeeId       String   @map("employee_id") @db.Uuid
  fiscalYearId     String   @map("fiscal_year_id") @db.Uuid
  taxRegimeId      String   @map("tax_regime_id") @db.Uuid
  electedAt        DateTime @default(now()) @map("elected_at") @db.Timestamptz(6)
  /// True when HR applied the statutory default because the employee did not
  /// elect within the window. Shown to the employee as such.
  isDefaultApplied Boolean  @default(false) @map("is_default_applied")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  regime     TaxRegime  @relation(fields: [taxRegimeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, fiscalYearId], map: "ux_tax_election__emp_fy")
  @@map("employee_tax_regime_election")
  @@schema("ess")
}

model EmployeeTaxDeclaration {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  employeeId       String               @map("employee_id") @db.Uuid
  fiscalYearId     String               @map("fiscal_year_id") @db.Uuid
  status           TaxDeclarationStatus @default(DRAFT)
  submittedAt      DateTime?            @map("submitted_at") @db.Timestamptz(6)
  verifiedAt       DateTime?            @map("verified_at") @db.Timestamptz(6)
  verifiedByUserId String?              @map("verified_by_user_id") @db.Uuid
  rejectionReason  String?              @map("rejection_reason")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion       Int                  @default(1) @map("row_version")

  employee   Employee                     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear                   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  items      EmployeeTaxDeclarationItem[]

  @@unique([employeeId, fiscalYearId], map: "ux_tax_declaration__emp_fy")
  @@index([organizationId, status], map: "ix_tax_declaration__org_status")
  @@map("employee_tax_declaration")
  @@schema("ess")
}

model EmployeeTaxDeclarationItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  declarationId     String   @map("declaration_id") @db.Uuid
  /// e.g. `80C`, `80D`, `HRA`, `24B`.
  sectionCode       String   @map("section_code")
  label             String
  declaredMinor     BigInt   @map("declared_minor")
  /// What payroll will actually allow after verification. Null until verified.
  verifiedMinor     BigInt?  @map("verified_minor")
  proofFileObjectId String?  @map("proof_file_object_id") @db.Uuid
  note              String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  declaration EmployeeTaxDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  proof       FileObject?            @relation("TaxProof", fields: [proofFileObjectId], references: [id], onDelete: SetNull)

  @@index([declarationId, sectionCode], map: "ix_tax_declaration_item__decl_section")
  @@map("employee_tax_declaration_item")
  @@schema("ess")
}

/// The persisted output of the tax engine for a financial year. The Tax screen
/// reads this rather than recomputing, so what an employee sees matches what
/// payroll deducted.
model EmployeeTaxProjection {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String   @map("organization_id") @db.Uuid
  employeeId              String   @map("employee_id") @db.Uuid
  fiscalYearId            String   @map("fiscal_year_id") @db.Uuid
  /// Which payroll run produced this projection.
  payrollRunId            String?  @map("payroll_run_id") @db.Uuid
  projectedGrossMinor     BigInt   @map("projected_gross_minor")
  exemptionsMinor         BigInt   @default(0) @map("exemptions_minor")
  deductionsMinor         BigInt   @default(0) @map("deductions_minor")
  taxableIncomeMinor      BigInt   @map("taxable_income_minor")
  computedTaxMinor        BigInt   @map("computed_tax_minor")
  cessMinor               BigInt   @default(0) @map("cess_minor")
  totalLiabilityMinor     BigInt   @map("total_liability_minor")
  tdsDeductedToDateMinor  BigInt   @default(0) @map("tds_deducted_to_date_minor")
  remainingLiabilityMinor BigInt   @map("remaining_liability_minor")
  computedAt              DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  @@unique([employeeId, fiscalYearId], map: "ux_tax_projection__emp_fy")
  @@map("employee_tax_projection")
  @@schema("ess")
}

/// Quarterly TDS, computed from published payslips only. A quarter shows an em
/// dash until a payslip in it has published — never an estimate.
model TdsQuarter {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  employeeId      String           @map("employee_id") @db.Uuid
  fiscalYearId    String           @map("fiscal_year_id") @db.Uuid
  fiscalQuarterId String           @map("fiscal_quarter_id") @db.Uuid
  status          TdsQuarterStatus @default(UPCOMING)
  /// Null until a payslip in this quarter has published.
  tdsMinor        BigInt?          @map("tds_minor")
  /// The acknowledgement number of the filed quarterly return.
  filingReference String?          @map("filing_reference")
  filedAt         DateTime?        @map("filed_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear    @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  quarter    FiscalQuarter @relation(fields: [fiscalQuarterId], references: [id], onDelete: Restrict)

  @@unique([employeeId, fiscalQuarterId], map: "ux_tds_quarter__emp_quarter")
  @@index([organizationId, fiscalYearId], map: "ix_tds_quarter__org_fy")
  @@map("tds_quarter")
  @@schema("ess")
}

model Form16Document {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  employeeId     String       @map("employee_id") @db.Uuid
  fiscalYearId   String       @map("fiscal_year_id") @db.Uuid
  status         Form16Status @default(PENDING)
  /// Null until the document is actually issued; the UI offers no download
  /// before then.
  fileObjectId   String?      @map("file_object_id") @db.Uuid
  issuedAt       DateTime?    @map("issued_at") @db.Timestamptz(6)
  issuedByUserId String?      @map("issued_by_user_id") @db.Uuid
  revision       Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear  @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  file       FileObject? @relation("Form16File", fields: [fileObjectId], references: [id], onDelete: SetNull)

  @@unique([employeeId, fiscalYearId, revision], map: "ux_form16__emp_fy_revision")
  @@index([organizationId, status], map: "ix_form16__org_status")
  @@map("form16_document")
  @@schema("ess")
}

// ═══════════════════════════════════════════════════════════════════════════
// Benefits
// ═══════════════════════════════════════════════════════════════════════════

model BenefitPlan {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  code                 String              @db.Citext
  name                 String
  category             BenefitCategory
  coverageKind         BenefitCoverageKind @map("coverage_kind")
  /// Sum insured or monthly amount, in paise, per coverageKind.
  coverageValueMinor   BigInt?             @map("coverage_value_minor")
  /// Multiplier for MULTIPLE_OF_CTC or PERCENT_OF_BASIC.
  coverageMultiplier   Decimal?            @map("coverage_multiplier") @db.Decimal(12, 6)
  provider             String?
  policyNumber         String?             @map("policy_number")
  /// What the card's action button does. NONE renders no button rather than a
  /// button that does nothing.
  action               BenefitAction       @default(NONE)
  documentFileObjectId String?             @map("document_file_object_id") @db.Uuid
  description          String?
  displayOrder         Int                 @default(0) @map("display_order") @db.SmallInt
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     FileObject?        @relation("BenefitDocument", fields: [documentFileObjectId], references: [id], onDelete: SetNull)
  planYears    BenefitPlanYear[]
  enrolments   BenefitEnrolment[]

  @@unique([organizationId, code], map: "ux_benefit_plan__org_code")
  @@map("benefit_plan")
  @@schema("ess")
}

model BenefitPlanYear {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId            String    @map("organization_id") @db.Uuid
  benefitPlanId             String    @map("benefit_plan_id") @db.Uuid
  startDate                 DateTime  @map("start_date") @db.Date
  endDate                   DateTime  @map("end_date") @db.Date
  /// When employees may change their enrolment.
  enrolmentOpensOn          DateTime? @map("enrolment_opens_on") @db.Date
  enrolmentClosesOn         DateTime? @map("enrolment_closes_on") @db.Date
  employerContributionMinor BigInt?   @map("employer_contribution_minor")
  employeeContributionMinor BigInt?   @map("employee_contribution_minor")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  plan       BenefitPlan        @relation(fields: [benefitPlanId], references: [id], onDelete: Cascade)
  enrolments BenefitEnrolment[]

  @@unique([benefitPlanId, startDate], map: "ux_benefit_plan_year__plan_start")
  @@map("benefit_plan_year")
  @@schema("ess")
}

model BenefitEnrolment {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                 @map("organization_id") @db.Uuid
  employeeId         String                 @map("employee_id") @db.Uuid
  benefitPlanId      String                 @map("benefit_plan_id") @db.Uuid
  benefitPlanYearId  String                 @map("benefit_plan_year_id") @db.Uuid
  status             BenefitEnrolmentStatus @default(ELIGIBLE)
  /// The actual sum insured for this employee, in paise. Resolved at enrolment
  /// from the plan and the employee's structure — the Benefits card shows this,
  /// not the plan's generic value.
  coverageValueMinor BigInt?                @map("coverage_value_minor")
  enrolledAt         DateTime?              @map("enrolled_at") @db.Timestamptz(6)
  effectiveFrom      DateTime?              @map("effective_from") @db.Date
  effectiveTo        DateTime?              @map("effective_to") @db.Date
  cardFileObjectId   String?                @map("card_file_object_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee   Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  plan       BenefitPlan                 @relation(fields: [benefitPlanId], references: [id], onDelete: Restrict)
  planYear   BenefitPlanYear             @relation(fields: [benefitPlanYearId], references: [id], onDelete: Restrict)
  card       FileObject?                 @relation("BenefitCard", fields: [cardFileObjectId], references: [id], onDelete: SetNull)
  dependents BenefitEnrolmentDependent[]

  @@unique([employeeId, benefitPlanYearId], map: "ux_benefit_enrolment__emp_year")
  @@index([organizationId, status], map: "ix_benefit_enrolment__org_status")
  @@map("benefit_enrolment")
  @@schema("ess")
}

model BenefitEnrolmentDependent {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  benefitEnrolmentId String    @map("benefit_enrolment_id") @db.Uuid
  dependentId        String    @map("dependent_id") @db.Uuid
  coveredFrom        DateTime? @map("covered_from") @db.Date
  coveredTo          DateTime? @map("covered_to") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  enrolment BenefitEnrolment @relation(fields: [benefitEnrolmentId], references: [id], onDelete: Cascade)
  dependent Dependent        @relation(fields: [dependentId], references: [id], onDelete: Cascade)

  @@unique([benefitEnrolmentId, dependentId], map: "ux_benefit_dependent__enrolment_dependent")
  @@map("benefit_enrolment_dependent")
  @@schema("ess")
}

model Dependent {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  employeeId     String                @map("employee_id") @db.Uuid
  fullName       String                @map("full_name")
  relationship   DependentRelationship
  dateOfBirth    DateTime?             @map("date_of_birth") @db.Date
  gender         Gender                @default(UNDISCLOSED)
  /// Generated by the database: avatar initials, so the UI never derives them.
  initials       String   @default(dbgenerated())
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee   Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  enrolments BenefitEnrolmentDependent[]
  nominees   Nominee[]

  @@index([organizationId, employeeId], map: "ix_dependent__org_emp")
  @@map("dependent")
  @@schema("ess")
}

model Nominee {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  dependentId    String?  @map("dependent_id") @db.Uuid
  fullName       String   @map("full_name")
  relationship   String
  /// Percentage share. Shares for one purpose must total 100.
  sharePercent   Decimal  @map("share_percent") @db.Decimal(5, 2)
  /// What this nomination covers, e.g. `GROUP_TERM_LIFE`, `PF`.
  purpose        String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dependent Dependent? @relation(fields: [dependentId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, purpose], map: "ix_nominee__org_emp_purpose")
  @@map("nominee")
  @@schema("ess")
}

// ═══════════════════════════════════════════════════════════════════════════
// Expenses
// ═══════════════════════════════════════════════════════════════════════════

model ExpenseCategory {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  code                 String   @db.Citext
  name                 String
  description          String?
  requiresReceipt      Boolean  @default(true) @map("requires_receipt")
  /// Claims older than this many days are rejected at submission.
  submissionWindowDays Int      @default(30) @map("submission_window_days") @db.SmallInt
  displayOrder         Int      @default(0) @map("display_order") @db.SmallInt
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  limits       ExpenseLimit[]
  lines        ExpenseClaimLine[]

  @@unique([organizationId, code], map: "ux_expense_category__org_code")
  @@map("expense_category")
  @@schema("ess")
}

model ExpenseLimit {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  expenseCategoryId   String            @map("expense_category_id") @db.Uuid
  basis               ExpenseLimitBasis
  capMinor            BigInt            @map("cap_minor")
  /// Optional narrowing: a limit can apply to one grade or location.
  designationGradeMin Int?              @map("designation_grade_min") @db.SmallInt
  effectiveFrom       DateTime          @map("effective_from") @db.Date
  effectiveTo         DateTime?         @map("effective_to") @db.Date
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  category ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)

  @@index([organizationId, expenseCategoryId, effectiveFrom], map: "ix_expense_limit__org_cat_from")
  @@map("expense_limit")
  @@schema("ess")
}

model ExpenseClaim {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  employeeId          String             @map("employee_id") @db.Uuid
  /// `EXP-2291` — stable and unique, printed on every approval notification.
  reference           String             @db.Citext
  title               String
  status              ExpenseClaimStatus @default(DRAFT)
  /// Sum of the lines, maintained in the same transaction as the lines.
  totalAmountMinor    BigInt             @default(0) @map("total_amount_minor")
  /// What Accounts approved, which may be less than claimed where a cap applied.
  approvedAmountMinor BigInt?            @map("approved_amount_minor")
  spendDate           DateTime           @map("spend_date") @db.Date
  submittedAt         DateTime?          @map("submitted_at") @db.Timestamptz(6)

  approverEmployeeId     String?   @map("approver_employee_id") @db.Uuid
  managerDecidedAt       DateTime? @map("manager_decided_at") @db.Timestamptz(6)
  managerDecidedByUserId String?   @map("manager_decided_by_user_id") @db.Uuid
  managerNote            String?   @map("manager_note")

  financeDecidedAt       DateTime? @map("finance_decided_at") @db.Timestamptz(6)
  financeDecidedByUserId String?   @map("finance_decided_by_user_id") @db.Uuid
  financeNote            String?   @map("finance_note")

  /// The batch, and through it the payroll cycle, that paid this claim.
  reimbursementBatchId String?   @map("reimbursement_batch_id") @db.Uuid
  reimbursedAt         DateTime? @map("reimbursed_at") @db.Timestamptz(6)

  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion  Int       @default(1) @map("row_version")

  employee    Employee            @relation("ExpenseClaimant", fields: [employeeId], references: [id], onDelete: Cascade)
  batch       ReimbursementBatch? @relation(fields: [reimbursementBatchId], references: [id], onDelete: SetNull)
  lines       ExpenseClaimLine[]
  attachments ExpenseAttachment[]

  @@unique([organizationId, reference], map: "ux_expense_claim__org_reference")
  @@index([organizationId, employeeId, status], map: "ix_expense_claim__org_emp_status")
  @@index([organizationId, approverEmployeeId, status], map: "ix_expense_claim__org_approver_status")
  @@index([organizationId, status, spendDate], map: "ix_expense_claim__org_status_date")
  @@map("expense_claim")
  @@schema("ess")
}

model ExpenseClaimLine {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  expenseClaimId      String   @map("expense_claim_id") @db.Uuid
  expenseCategoryId   String   @map("expense_category_id") @db.Uuid
  description         String
  spendDate           DateTime @map("spend_date") @db.Date
  amountMinor         BigInt   @map("amount_minor")
  approvedAmountMinor BigInt?  @map("approved_amount_minor")
  /// Recorded when a cap reduced the approved amount, so the employee is told why.
  capAppliedNote      String?  @map("cap_applied_note")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  claim    ExpenseClaim    @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)

  @@index([organizationId, expenseClaimId], map: "ix_expense_line__org_claim")
  @@map("expense_claim_line")
  @@schema("ess")
}

model ExpenseAttachment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  expenseClaimId String   @map("expense_claim_id") @db.Uuid
  fileObjectId   String   @map("file_object_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claim ExpenseClaim @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)
  file  FileObject   @relation("ExpenseBill", fields: [fileObjectId], references: [id], onDelete: Restrict)

  @@unique([expenseClaimId, fileObjectId], map: "ux_expense_attachment__claim_file")
  @@map("expense_attachment")
  @@schema("ess")
}

/// The bridge between expenses and payroll: a set of approved claims paid with
/// one payroll cycle. This is what makes "paying 30 Sep with September salary"
/// a fact rather than a caption.
model ReimbursementBatch {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                   @map("organization_id") @db.Uuid
  payrollCycleId   String?                  @map("payroll_cycle_id") @db.Uuid
  reference        String                   @db.Citext
  status           ReimbursementBatchStatus @default(DRAFT)
  /// Claims approved on or before this date are included.
  cutoffDate       DateTime                 @map("cutoff_date") @db.Date
  claimCount       Int                      @default(0) @map("claim_count")
  totalAmountMinor BigInt                   @default(0) @map("total_amount_minor")
  lockedAt         DateTime?                @map("locked_at") @db.Timestamptz(6)
  paidAt           DateTime?                @map("paid_at") @db.Timestamptz(6)
  createdByUserId  String                   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion       Int                      @default(1) @map("row_version")

  cycle  PayrollCycle?  @relation(fields: [payrollCycleId], references: [id], onDelete: SetNull)
  claims ExpenseClaim[]

  @@unique([organizationId, reference], map: "ux_reimbursement_batch__org_reference")
  @@index([organizationId, status], map: "ix_reimbursement_batch__org_status")
  @@map("reimbursement_batch")
  @@schema("ess")
}

/// Year-to-date expense totals, maintained as claims change state. The three
/// stat tiles on the Expenses screen read this.
model ExpenseFyRollup {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  fiscalYearId    String   @map("fiscal_year_id") @db.Uuid
  pendingCount    Int      @default(0) @map("pending_count")
  pendingMinor    BigInt   @default(0) @map("pending_minor")
  approvedCount   Int      @default(0) @map("approved_count")
  approvedMinor   BigInt   @default(0) @map("approved_minor")
  reimbursedCount Int      @default(0) @map("reimbursed_count")
  reimbursedMinor BigInt   @default(0) @map("reimbursed_minor")
  rejectedCount   Int      @default(0) @map("rejected_count")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@unique([employeeId, fiscalYearId], map: "ux_expense_rollup__emp_fy")
  @@index([organizationId, fiscalYearId], map: "ix_expense_rollup__org_fy")
  @@map("expense_fy_rollup")
  @@schema("ess")
}

// ═══════════════════════════════════════════════════════════════════════════
// Documents and letters
// ═══════════════════════════════════════════════════════════════════════════

model DocumentType {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  code           String             @db.Citext
  name           String
  category       String
  visibility     DocumentVisibility @default(EMPLOYEE_AND_HR)
  /// True when an employee may request this as a letter.
  isRequestable  Boolean            @default(false) @map("is_requestable")
  displayOrder   Int                @default(0) @map("display_order") @db.SmallInt
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents    EmployeeDocument[]
  templates    LetterTemplate[]
  requests     DocumentRequest[]

  @@unique([organizationId, code], map: "ux_document_type__org_code")
  @@map("document_type")
  @@schema("ess")
}

model EmployeeDocument {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  employeeId       String   @map("employee_id") @db.Uuid
  documentTypeId   String   @map("document_type_id") @db.Uuid
  title            String
  fileObjectId     String   @map("file_object_id") @db.Uuid
  /// The date the document itself carries, which is not when it was uploaded.
  documentDate     DateTime @map("document_date") @db.Date
  uploadedByUserId String?  @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type     DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  file     FileObject   @relation("EmployeeDocumentFile", fields: [fileObjectId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, documentDate], map: "ix_employee_document__org_emp_date")
  @@map("employee_document")
  @@schema("ess")
}

model LetterTemplate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  documentTypeId String   @map("document_type_id") @db.Uuid
  name           String
  /// Handlebars-style body. Placeholders are resolved from persisted employee
  /// data only; a template cannot introduce a value the database does not hold.
  bodyTemplate   String   @map("body_template")
  /// Which placeholders this template uses, validated at save time.
  requiredFields String[] @map("required_fields")
  version        Int      @default(1)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  type     DocumentType      @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  requests DocumentRequest[]

  @@unique([organizationId, documentTypeId, version], map: "ux_letter_template__org_type_version")
  @@map("letter_template")
  @@schema("ess")
}

model DocumentRequest {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  employeeId       String                @map("employee_id") @db.Uuid
  documentTypeId   String                @map("document_type_id") @db.Uuid
  letterTemplateId String?               @map("letter_template_id") @db.Uuid
  status           DocumentRequestStatus @default(SUBMITTED)
  /// Who the letter is addressed to, e.g. `HDFC Bank`.
  addressee        String?
  purpose          String?
  requestedAt      DateTime              @default(now()) @map("requested_at") @db.Timestamptz(6)
  startedAt        DateTime?             @map("started_at") @db.Timestamptz(6)
  issuedAt         DateTime?             @map("issued_at") @db.Timestamptz(6)
  issuedByUserId   String?               @map("issued_by_user_id") @db.Uuid
  /// Null until issued; the UI offers no download before then.
  fileObjectId     String?               @map("file_object_id") @db.Uuid
  rejectionReason  String?               @map("rejection_reason")
  cancelledAt      DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion       Int                   @default(1) @map("row_version")

  employee Employee        @relation("DocumentRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  type     DocumentType    @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  template LetterTemplate? @relation(fields: [letterTemplateId], references: [id], onDelete: SetNull)
  file     FileObject?     @relation("LetterFile", fields: [fileObjectId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, status], map: "ix_document_request__org_emp_status")
  @@index([organizationId, status], map: "ix_document_request__org_status")
  @@map("document_request")
  @@schema("ess")
}

/// An employee's request to change a field they cannot edit directly. HR or
/// Payroll verifies the proof, and applying it writes a before/after audit entry.
model ProfileChangeRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  employeeId        String    @map("employee_id") @db.Uuid
  /// personal | employment | bank | emergency
  section           String
  /// Requested values, keyed by field. Sensitive values are sealed.
  requestedChanges  Json      @map("requested_changes")
  /// SUBMITTED | UNDER_REVIEW | APPLIED | REJECTED | WITHDRAWN
  status            String    @default("SUBMITTED")
  proofFileObjectId String?   @map("proof_file_object_id") @db.Uuid
  /// The help-desk ticket raised alongside, so the employee can track it.
  ticketId          String?   @map("ticket_id") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedByUserId  String?   @map("reviewed_by_user_id") @db.Uuid
  decisionNote      String?   @map("decision_note")
  appliedAt         DateTime? @map("applied_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion        Int       @default(1) @map("row_version")

  employee Employee    @relation("ChangeRequestSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  proof    FileObject? @relation("ChangeProof", fields: [proofFileObjectId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, status], map: "ix_change_request__org_emp_status")
  @@index([organizationId, status], map: "ix_change_request__org_status")
  @@map("profile_change_request")
  @@schema("ess")
}

// ═══════════════════════════════════════════════════════════════════════════
// Policies
// ═══════════════════════════════════════════════════════════════════════════

model Policy {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.Citext
  name           String
  /// The team that owns it, e.g. `People Ops`, `IT & Security`.
  ownerTeam      String       @map("owner_team")
  contactEmail   String?      @map("contact_email") @db.Citext
  status         PolicyStatus @default(DRAFT)
  displayOrder   Int          @default(0) @map("display_order") @db.SmallInt
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     PolicyVersion[]

  @@unique([organizationId, code], map: "ux_policy__org_code")
  @@index([organizationId, status], map: "ix_policy__org_status")
  @@map("policy")
  @@schema("ess")
}

/// A version is never edited after publication. A change publishes a new
/// version and supersedes the old one, so an acknowledgement always refers to
/// text that still exists exactly as it was read.
model PolicyVersion {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String              @map("organization_id") @db.Uuid
  policyId                String              @map("policy_id") @db.Uuid
  /// `v4.2` as the prototype shows it.
  versionLabel            String              @map("version_label")
  /// Monotonic ordering, independent of the label's format.
  versionNumber           Int                 @map("version_number")
  status                  PolicyVersionStatus @default(DRAFT)
  summary                 String
  /// Sanitised HTML or Markdown. Rendered through the one component permitted
  /// to emit server-supplied markup, after sanitisation.
  body                    String
  effectiveFrom           DateTime            @map("effective_from") @db.Date
  reviewDueOn             DateTime?           @map("review_due_on") @db.Date
  /// How long an employee has to acknowledge after it is assigned.
  acknowledgementDueDays  Int?                @map("acknowledgement_due_days") @db.SmallInt
  requiresAcknowledgement Boolean             @default(true) @map("requires_acknowledgement")
  pdfFileObjectId         String?             @map("pdf_file_object_id") @db.Uuid
  publishedAt             DateTime?           @map("published_at") @db.Timestamptz(6)
  publishedByUserId       String?             @map("published_by_user_id") @db.Uuid
  supersededAt            DateTime?           @map("superseded_at") @db.Timestamptz(6)
  supersededByVersionId   String?             @map("superseded_by_version_id") @db.Uuid
  withdrawnAt             DateTime?           @map("withdrawn_at") @db.Timestamptz(6)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion              Int                 @default(1) @map("row_version")

  policy           Policy                    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  pdf              FileObject?               @relation("PolicyPdf", fields: [pdfFileObjectId], references: [id], onDelete: SetNull)
  supersededBy     PolicyVersion?            @relation("PolicySupersedes", fields: [supersededByVersionId], references: [id], onDelete: SetNull)
  supersedes       PolicyVersion[]           @relation("PolicySupersedes")
  points           PolicyVersionPoint[]
  applicability    PolicyApplicabilityRule[]
  assignments      PolicyAssignment[]
  acknowledgements PolicyAcknowledgement[]

  @@unique([policyId, versionNumber], map: "ux_policy_version__policy_number")
  @@index([organizationId, status, effectiveFrom], map: "ix_policy_version__org_status_from")
  @@map("policy_version")
  @@schema("ess")
}

/// The bullet points the Policies screen lists under a version.
model PolicyVersionPoint {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyVersionId String   @map("policy_version_id") @db.Uuid
  text            String
  displayOrder    Int      @map("display_order") @db.SmallInt
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  version PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  @@index([policyVersionId, displayOrder], map: "ix_policy_point__version_order")
  @@map("policy_version_point")
  @@schema("ess")
}

/// Who a version applies to. Resolved into PolicyAssignment rows at publication,
/// so "12 of 340 people still owe an acknowledgement" is a count of real rows.
model PolicyApplicabilityRule {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                       @map("organization_id") @db.Uuid
  policyVersionId String                       @map("policy_version_id") @db.Uuid
  dimension       PolicyApplicabilityDimension
  /// The department, location, employment type or employee this rule names.
  /// Null when the dimension is ALL.
  targetId        String?                      @map("target_id") @db.Uuid
  targetValue     String?                      @map("target_value")
  /// An exclusion rule removes people a broader rule included.
  isExclusion     Boolean                      @default(false) @map("is_exclusion")
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  version PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  @@index([organizationId, policyVersionId], map: "ix_policy_rule__org_version")
  @@map("policy_applicability_rule")
  @@schema("ess")
}

/// One row per employee per applicable version, created at publication. The
/// Home screen's "to do" list and the Policies badge count these.
model PolicyAssignment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  policyVersionId String    @map("policy_version_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  assignedAt      DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  dueOn           DateTime? @map("due_on") @db.Date

  version  PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, employeeId], map: "ux_policy_assignment__version_emp")
  @@index([organizationId, employeeId], map: "ix_policy_assignment__org_emp")
  @@map("policy_assignment")
  @@schema("ess")
}

/// The acknowledgement record the requirement names: employee, policy version,
/// status and timestamp. Immutable once ACKNOWLEDGED — a later version creates
/// a new row rather than resetting this one.
model PolicyAcknowledgement {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  policyVersionId       String          @map("policy_version_id") @db.Uuid
  employeeId            String          @map("employee_id") @db.Uuid
  status                PolicyAckStatus @default(PENDING)
  acknowledgedAt        DateTime?       @map("acknowledged_at") @db.Timestamptz(6)
  /// Captured with the acknowledgement as evidence of who confirmed it.
  acknowledgedIp        String?         @map("acknowledged_ip") @db.Inet
  acknowledgedUserAgent String?         @map("acknowledged_user_agent")
  dueOn                 DateTime?       @map("due_on") @db.Date
  waivedAt              DateTime?       @map("waived_at") @db.Timestamptz(6)
  waivedByUserId        String?         @map("waived_by_user_id") @db.Uuid
  waiveReason           String?         @map("waive_reason")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  version  PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, employeeId], map: "ux_policy_ack__version_emp")
  @@index([organizationId, employeeId, status], map: "ix_policy_ack__org_emp_status")
  @@index([organizationId, status, dueOn], map: "ix_policy_ack__org_status_due")
  @@map("policy_acknowledgement")
  @@schema("ess")
}

// ═══════════════════════════════════════════════════════════════════════════
// Announcements, help desk and notifications
// ═══════════════════════════════════════════════════════════════════════════

model Announcement {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  title             String
  /// Sanitised rich text, rendered through the one permitted component.
  body              String
  /// The team it comes from, e.g. `People Ops`, `Finance`.
  departmentLabel   String             @map("department_label")
  authorEmployeeId  String?            @map("author_employee_id") @db.Uuid
  /// `Ananya Bose · People Ops` — the byline, resolved at publication.
  byline            String?
  status            AnnouncementStatus @default(DRAFT)
  isPinned          Boolean            @default(false) @map("is_pinned")
  publishAt         DateTime?          @map("publish_at") @db.Timestamptz(6)
  publishedAt       DateTime?          @map("published_at") @db.Timestamptz(6)
  publishedByUserId String?            @map("published_by_user_id") @db.Uuid
  expiresAt         DateTime?          @map("expires_at") @db.Timestamptz(6)
  archivedAt        DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion        Int                @default(1) @map("row_version")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  paragraphs   AnnouncementParagraph[]
  audiences    AnnouncementAudience[]
  reads        AnnouncementRead[]

  @@index([organizationId, status, publishedAt], map: "ix_announcement__org_status_published")
  @@index([organizationId, isPinned, publishedAt], map: "ix_announcement__org_pinned")
  @@map("announcement")
  @@schema("ess")
}

/// The body as ordered paragraphs, matching how the prototype renders one.
model AnnouncementParagraph {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  announcementId String @map("announcement_id") @db.Uuid
  text           String
  displayOrder   Int    @map("display_order") @db.SmallInt

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId, displayOrder], map: "ix_announcement_para__ann_order")
  @@map("announcement_paragraph")
  @@schema("ess")
}

model AnnouncementAudience {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  announcementId String                   @map("announcement_id") @db.Uuid
  kind           AnnouncementAudienceKind
  targetId       String?                  @map("target_id") @db.Uuid
  targetValue    String?                  @map("target_value")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([organizationId, announcementId], map: "ix_announcement_audience__org_ann")
  @@map("announcement_audience")
  @@schema("ess")
}

model AnnouncementRead {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([announcementId, employeeId], map: "ux_announcement_read__ann_emp")
  @@index([organizationId, employeeId], map: "ix_announcement_read__org_emp")
  @@map("announcement_read")
  @@schema("ess")
}

model TicketCategory {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  code               String   @db.Citext
  name               String
  description        String?
  /// Where a ticket in this category is routed, in addition to the
  /// organisation's help-desk address.
  routingEmail       String?  @map("routing_email") @db.Citext
  /// SLA clocks in hours, used to compute due times from persisted timestamps.
  firstResponseHours Int      @default(24) @map("first_response_hours") @db.SmallInt
  resolutionHours    Int      @default(72) @map("resolution_hours") @db.SmallInt
  displayOrder       Int      @default(0) @map("display_order") @db.SmallInt
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tickets      HelpdeskTicket[]

  @@unique([organizationId, code], map: "ux_ticket_category__org_code")
  @@map("ticket_category")
  @@schema("ess")
}

/// A help-desk ticket. Creating one persists the ticket and enqueues the email
/// to the organisation's help-desk address in the same transaction, so a mail
/// outage can never lose a ticket — and the UI reports the real delivery state
/// rather than assuming success.
model HelpdeskTicket {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  /// `HD-4821` — stable and unique, quoted in every notification.
  reference           String         @db.Citext
  ticketCategoryId    String         @map("ticket_category_id") @db.Uuid
  requesterEmployeeId String         @map("requester_employee_id") @db.Uuid
  assigneeEmployeeId  String?        @map("assignee_employee_id") @db.Uuid
  subject             String
  description         String
  status              TicketStatus   @default(OPEN)
  priority            TicketPriority @default(NORMAL)

  /// Computed from the category's SLA and the persisted timestamps below.
  firstResponseDueAt DateTime? @map("first_response_due_at") @db.Timestamptz(6)
  resolutionDueAt    DateTime? @map("resolution_due_at") @db.Timestamptz(6)
  firstResponseAt    DateTime? @map("first_response_at") @db.Timestamptz(6)
  /// Accumulated time spent waiting on the requester, excluded from the SLA.
  pausedSeconds      Int       @default(0) @map("paused_seconds")
  pausedAt           DateTime? @map("paused_at") @db.Timestamptz(6)

  assignedAt     DateTime? @map("assigned_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  reopenedAt     DateTime? @map("reopened_at") @db.Timestamptz(6)
  resolutionNote String?   @map("resolution_note")

  /// Where the source of the ticket was something else, e.g. a profile change
  /// request. Lets the employee follow one thread.
  sourceType String? @map("source_type")
  sourceId   String? @map("source_id") @db.Uuid

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion Int      @default(1) @map("row_version")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     TicketCategory     @relation(fields: [ticketCategoryId], references: [id], onDelete: Restrict)
  requester    Employee           @relation("TicketRequester", fields: [requesterEmployeeId], references: [id], onDelete: Restrict)
  assignee     Employee?          @relation("TicketAssignee", fields: [assigneeEmployeeId], references: [id], onDelete: SetNull)
  comments     TicketComment[]
  attachments  TicketAttachment[]

  @@unique([organizationId, reference], map: "ux_ticket__org_reference")
  @@index([organizationId, requesterEmployeeId, status], map: "ix_ticket__org_requester_status")
  @@index([organizationId, assigneeEmployeeId, status], map: "ix_ticket__org_assignee_status")
  @@index([organizationId, status, createdAt], map: "ix_ticket__org_status_created")
  @@map("helpdesk_ticket")
  @@schema("ess")
}

model TicketComment {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                  @map("organization_id") @db.Uuid
  ticketId         String                  @map("ticket_id") @db.Uuid
  authorEmployeeId String?                 @map("author_employee_id") @db.Uuid
  authorUserId     String?                 @map("author_user_id") @db.Uuid
  body             String
  /// An INTERNAL comment is never returned to the requester.
  visibility       TicketCommentVisibility @default(PUBLIC)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author Employee?      @relation(fields: [authorEmployeeId], references: [id], onDelete: SetNull)

  @@index([organizationId, ticketId, createdAt], map: "ix_ticket_comment__org_ticket_time")
  @@map("ticket_comment")
  @@schema("ess")
}

model TicketAttachment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  fileObjectId   String   @map("file_object_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  file   FileObject     @relation("TicketFile", fields: [fileObjectId], references: [id], onDelete: Restrict)

  @@unique([ticketId, fileObjectId], map: "ux_ticket_attachment__ticket_file")
  @@map("ticket_attachment")
  @@schema("ess")
}

/// Reference data, seeded. The Help desk screen's FAQ accordion.
model FaqArticle {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  question         String
  answer           String
  ticketCategoryId String?  @map("ticket_category_id") @db.Uuid
  displayOrder     Int      @default(0) @map("display_order") @db.SmallInt
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, isActive, displayOrder], map: "ix_faq__org_active_order")
  @@map("faq_article")
  @@schema("ess")
}

/// Every notification is produced by a persisted event. There is no generator
/// that invents something to say, and none that counts anything the database
/// cannot confirm.
model Notification {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  appUserId      String           @map("app_user_id") @db.Uuid
  kind           NotificationKind
  tone           NotificationTone @default(BLUE)
  title          String
  body           String?
  /// The module a click navigates to, and the record within it.
  targetModule   String?          @map("target_module")
  targetId       String?          @map("target_id") @db.Uuid
  /// What produced this, so a notification can always be traced to its event.
  sourceType     String           @map("source_type")
  sourceId       String           @map("source_id") @db.Uuid
  readAt         DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@unique([appUserId, sourceType, sourceId, kind], map: "ux_notification__user_source_kind")
  @@index([organizationId, appUserId, readAt, createdAt], map: "ix_notification__org_user_unread")
  @@map("notification")
  @@schema("ess")
}

// ═══════════════════════════════════════════════════════════════════════════
// Approvals — the unified Manager queue
// ═══════════════════════════════════════════════════════════════════════════

/// One pending decision for one approver. Leave, expenses and attendance all
/// create these, so the Approvals badge is a count of rows and the queue is one
/// query rather than three unions computed in the UI.
model ApprovalTask {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  kind               ApprovalTaskKind
  status             ApprovalTaskStatus @default(PENDING)
  /// The record awaiting a decision.
  subjectType        String             @map("subject_type")
  subjectId          String             @map("subject_id") @db.Uuid
  /// The employee the decision is about.
  subjectEmployeeId  String             @map("subject_employee_id") @db.Uuid
  assigneeEmployeeId String             @map("assignee_employee_id") @db.Uuid
  /// Display fields resolved at creation from persisted data, so the queue
  /// renders without joining five tables — and never invents a summary.
  title              String
  subtitle           String?
  amountMinor        BigInt?            @map("amount_minor")
  requestedAt        DateTime           @map("requested_at") @db.Timestamptz(6)
  dueAt              DateTime?          @map("due_at") @db.Timestamptz(6)
  decidedAt          DateTime?          @map("decided_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion         Int                @default(1) @map("row_version")

  assignee        Employee           @relation("ApprovalAssignee", fields: [assigneeEmployeeId], references: [id], onDelete: Restrict)
  subjectEmployee Employee           @relation("ApprovalSubject", fields: [subjectEmployeeId], references: [id], onDelete: Cascade)
  decisions       ApprovalDecision[]

  @@unique([subjectType, subjectId, assigneeEmployeeId], map: "ux_approval_task__subject_assignee")
  @@index([organizationId, assigneeEmployeeId, status, requestedAt], map: "ix_approval_task__org_assignee_status")
  @@index([organizationId, subjectEmployeeId], map: "ix_approval_task__org_subject")
  @@map("approval_task")
  @@schema("ess")
}

/// Append-only. Every decision on every task, including reassignments and
/// escalations, kept for the audit trail.
model ApprovalDecision {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  approvalTaskId      String                  @map("approval_task_id") @db.Uuid
  outcome             ApprovalDecisionOutcome
  decidedByUserId     String                  @map("decided_by_user_id") @db.Uuid
  decidedByEmployeeId String?                 @map("decided_by_employee_id") @db.Uuid
  note                String?
  ip                  String?                 @db.Inet
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  task ApprovalTask @relation(fields: [approvalTaskId], references: [id], onDelete: Cascade)

  @@index([organizationId, approvalTaskId], map: "ix_approval_decision__org_task")
  @@map("approval_decision")
  @@schema("ess")
}

// ═══════════════════════════════════════════════════════════════════════════
// Cross-cutting: audit, files, keys, email, operations
// ═══════════════════════════════════════════════════════════════════════════

/// Append-only and hash-chained. Each row's digest is an HMAC over the previous
/// digest and the row's own content, keyed by a secret the database never sees.
/// Someone with write access to the database can alter a row, but cannot
/// recompute a valid chain, so the tampering is detectable.
///
/// Written in the same transaction as the change it records: if the audit entry
/// cannot be written, the change does not happen.
model AuditEvent {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  /// Monotonic position in the chain, assigned by a sequence.
  sequence        BigInt
  actorKind       ActorKind   @default(USER) @map("actor_kind")
  actorUserId     String?     @map("actor_user_id") @db.Uuid
  actorEmployeeId String?     @map("actor_employee_id") @db.Uuid
  /// The persona the actor was acting under, so a decision can be attributed
  /// to the role that authorised it.
  actorPersona    Persona?    @map("actor_persona")
  action          AuditAction
  entityType      String      @map("entity_type")
  entityId        String?     @map("entity_id") @db.Uuid
  /// For STATE_TRANSITION: where it moved from and to.
  fromState       String?     @map("from_state")
  toState         String?     @map("to_state")
  /// Before and after images, with sensitive fields redacted before storage.
  beforeData      Json?       @map("before_data")
  afterData       Json?       @map("after_data")
  summary         String?
  ip              String?     @db.Inet
  userAgent       String?     @map("user_agent")
  requestId       String?     @map("request_id")
  occurredAt      DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)

  /// Digest of the preceding row; the first row uses 64 zeroes.
  previousHash String @map("previous_hash")
  /// HMAC-SHA256 over previousHash and this row's canonical content.
  rowHash      String @map("row_hash")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        AppUser?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sequence], map: "ux_audit_event__org_sequence")
  @@index([organizationId, entityType, entityId, occurredAt], map: "ix_audit_event__org_entity")
  @@index([organizationId, actorUserId, occurredAt], map: "ix_audit_event__org_actor")
  @@index([organizationId, action, occurredAt], map: "ix_audit_event__org_action")
  @@index([requestId], map: "ix_audit_event__request")
  @@map("audit_event")
  @@schema("ess")
}

/// Metadata for every stored file. The bytes live in object storage; this row
/// is what authorization is checked against before a signed URL is issued.
model FileObject {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  purpose           FilePurpose
  /// Server-generated storage key. Never derived from a client filename.
  storageKey        String         @unique @map("storage_key")
  /// Sanitised filename offered to the browser on download.
  displayFilename   String         @map("display_filename")
  /// The type confirmed by sniffing the bytes, not the one the client declared.
  contentType       String         @map("content_type")
  sizeBytes         Int            @map("size_bytes")
  sha256            String
  scanStatus        FileScanStatus @default(PENDING) @map("scan_status")
  scannedAt         DateTime?      @map("scanned_at") @db.Timestamptz(6)
  /// Who uploaded it, for the audit trail and for quota accounting.
  uploadedByUserId  String?        @map("uploaded_by_user_id") @db.Uuid
  /// The employee the file is about, for scope checks on download.
  subjectEmployeeId String?        @map("subject_employee_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when the file is scheduled for deletion under the retention schedule.
  deleteAfter       DateTime?      @map("delete_after") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  employeePhotos    Employee[]                   @relation("EmployeePhoto")
  bankProofs        EmployeeBankAccount[]        @relation("BankProof")
  leaveDocuments    LeaveRequest[]               @relation("LeaveDocument")
  payrollInputFiles PayrollInputBatch[]          @relation("PayrollInputFile")
  payslipPdfs       Payslip[]                    @relation("PayslipPdf")
  taxProofs         EmployeeTaxDeclarationItem[] @relation("TaxProof")
  form16Files       Form16Document[]             @relation("Form16File")
  benefitDocuments  BenefitPlan[]                @relation("BenefitDocument")
  benefitCards      BenefitEnrolment[]           @relation("BenefitCard")
  expenseBills      ExpenseAttachment[]          @relation("ExpenseBill")
  employeeDocuments EmployeeDocument[]           @relation("EmployeeDocumentFile")
  letterFiles       DocumentRequest[]            @relation("LetterFile")
  changeProofs      ProfileChangeRequest[]       @relation("ChangeProof")
  policyPdfs        PolicyVersion[]              @relation("PolicyPdf")
  ticketFiles       TicketAttachment[]           @relation("TicketFile")

  @@index([organizationId, purpose, createdAt], map: "ix_file_object__org_purpose")
  @@index([organizationId, subjectEmployeeId], map: "ix_file_object__org_subject")
  @@index([scanStatus], map: "ix_file_object__scan_status")
  @@index([deleteAfter], map: "ix_file_object__delete_after")
  @@map("file_object")
  @@schema("ess")
}

/// Wrapped data-encryption keys. The key-encrypting key never reaches the
/// database, so these rows are useless without the application secret. Rotation
/// adds a new version and re-wraps lazily.
model DataEncryptionKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version     String    @unique
  /// DEK encrypted under the KEK.
  wrappedKey  Bytes     @map("wrapped_key")
  wrapIv      Bytes     @map("wrap_iv")
  wrapTag     Bytes     @map("wrap_tag")
  algorithm   String    @default("aes-256-gcm")
  isActive    Boolean   @default(true) @map("is_active")
  activatedAt DateTime  @default(now()) @map("activated_at") @db.Timestamptz(6)
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("data_encryption_key")
  @@schema("ess")
}

/// Transactional outbox. A message is enqueued in the same transaction as the
/// change that warrants it, and a worker delivers it with backoff. A mail
/// outage delays delivery; it never loses the record.
model EmailOutbox {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  kind              EmailKind
  status            EmailStatus @default(QUEUED)
  toAddresses       String[]    @map("to_addresses")
  ccAddresses       String[]    @default([]) @map("cc_addresses")
  replyTo           String?     @map("reply_to")
  subject           String
  bodyText          String      @map("body_text")
  bodyHtml          String?     @map("body_html")
  /// What warrants this message, so a delivery can be traced to its cause.
  sourceType        String      @map("source_type")
  sourceId          String      @map("source_id") @db.Uuid
  /// Deduplication key: an at-least-once worker must not send twice.
  idempotencyKey    String      @unique @map("idempotency_key")
  attempts          Int         @default(0)
  nextAttemptAt     DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError         String?     @map("last_error")
  providerMessageId String?     @map("provider_message_id")
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt], map: "ix_email_outbox__status_next")
  @@index([organizationId, sourceType, sourceId], map: "ix_email_outbox__org_source")
  @@map("email_outbox")
  @@schema("ess_ops")
}

/// Replay protection for mutating requests. A retried request with the same key
/// returns the original response instead of acting twice.
model IdempotencyRecord {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String
  appUserId    String   @map("app_user_id") @db.Uuid
  method       String
  path         String
  /// Digest of the request body, so the same key with a different body is a
  /// conflict rather than a silent replay of the wrong response.
  requestHash  String   @map("request_hash")
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([appUserId, key], map: "ux_idempotency__user_key")
  @@index([expiresAt], map: "ix_idempotency__expiry")
  @@map("idempotency_record")
  @@schema("ess_ops")
}

/// Background jobs: accrual runs, SLA sweeps, retention deletions, payslip PDF
/// rendering. Claimed with SKIP LOCKED so several workers can share the queue.
model JobRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  jobName        String    @map("job_name")
  /// QUEUED | RUNNING | SUCCEEDED | FAILED
  status         String    @default("QUEUED")
  payload        Json?
  attempts       Int       @default(0)
  scheduledFor   DateTime  @default(now()) @map("scheduled_for") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error")
  /// Which worker holds it, so a crashed worker's jobs can be reclaimed.
  lockedBy       String?   @map("locked_by")
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, scheduledFor], map: "ix_job_run__status_scheduled")
  @@index([jobName, status], map: "ix_job_run__name_status")
  @@map("job_run")
  @@schema("ess_ops")
}

/// The declared state machines, seeded as reference data. The service layer
/// checks a transition against this table before every state change, so an
/// undeclared transition cannot happen even if application code asks for it.
model StateTransition {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  machine      String
  fromState    String   @map("from_state")
  toState      String   @map("to_state")
  event        String
  /// The persona permitted to raise it, or null when the system raises it.
  actorPersona Persona? @map("actor_persona")
  description  String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([machine, fromState, event], map: "ux_state_transition__machine_from_event")
  @@index([machine], map: "ix_state_transition__machine")
  @@map("state_transition")
  @@schema("ess")
}
